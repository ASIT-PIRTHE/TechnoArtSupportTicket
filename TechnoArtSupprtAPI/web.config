<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Handle 3000 concurrent users -->
   <!-- <serverRuntime appConcurrentRequestLimit="5000" /> -->

    <!-- Enable compression — reduces response size 70% -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Static file caching — 7 days -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- Security headers -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <!-- Disable debugging in production -->
    <httpErrors existingResponse="PassThrough" />

    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\TassomAPI.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
  </system.webServer>

  <system.web>
    <!-- Thread limits for 3000 users -->
    <processModel 
      maxWorkerThreads="100" 
      maxIoThreads="100"
      minWorkerThreads="25"
      minIoThreads="25" />

    <!-- Request settings -->
    <httpRuntime 
      executionTimeout="120"
      maxRequestLength="10240"
      requestQueueLimit="5000"
      enableVersionHeader="false" />
  </system.web>
</configuration>
