IF NOT EXISTS (SELECT * FROM sys.indexes WHERE name = 'IX_Users_Role' AND object_id = OBJECT_ID('dbo.Users'))
CREATE NONCLUSTERED INDEX IX_Users_Role ON dbo.Users(Role);
