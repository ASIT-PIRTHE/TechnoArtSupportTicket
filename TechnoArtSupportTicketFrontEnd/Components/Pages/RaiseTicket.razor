@page "/raise-ticket"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using TechnoArtSupportTicketFrontEnd.Services
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject ApiService BackendApi
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Raise New Ticket - SupportHub</PageTitle>

<div class="container-fluid py-2 py-md-4 px-2 px-md-3" style="max-width: 100%; overflow-x: hidden;">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">
            <!-- Modern Header -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Raise a Support Ticket</h3>
                    <p class="text-muted mb-0">Submit a new issue or request for our software engineering & support teams.</p>
                </div>
                <div class="icon-badge p-3 rounded-circle d-none d-sm-block">
                    <i class="bi bi-ticket-plus fs-3"></i>
                </div>
            </div>

            <div class="card glass-card rounded-4 overflow-hidden mb-5">
                <div class="card-body p-3 p-md-5">
                    
                    @if (isSuccess)
                    {
                        <div class="alert alert-success d-flex align-items-sm-center flex-column flex-sm-row p-4 mb-4 border-0 rounded-3 bg-success bg-opacity-10">
                            <i class="bi bi-check-circle-fill fs-1 text-success me-sm-4 mb-3 mb-sm-0"></i>
                            <div>
                                <h5 class="alert-heading fw-bold text-success mb-1">Ticket Created Successfully!</h5>
                                <p class="mb-0 text-success opacity-75">Your ticket number is <strong class="badge bg-success fs-6 ms-1">@generatedTicketNum</strong></p>
                                <hr class="border-success opacity-25 my-2">
                                <p class="mb-0 small text-success opacity-75">The Project Manager and dedicated module team have received your ticket and are tracking it. You can monitor progress on your dashboard.</p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center p-3 mb-4 rounded-3 border-0 bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
                            <div>
                                <span class="fw-semibold">Error:</span> @errorMessage
                            </div>
                        </div>
                    }

                    <form @onsubmit="SubmitTicket">
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-sm-6 @(isClient ? "col-md-4" : "col-md-3")">
                                <label class="form-label fw-bold text-dark small mb-2">Project <span class="text-danger">*</span></label>
                                @if (isClient && projects.Count == 1)
                                {
                                    var onlyP = projects[0];
                                    var pNm = onlyP.TryGetProperty("name", out var pnmp) ? pnmp.GetString() ?? "" : "";
                                    var pCd = onlyP.TryGetProperty("code", out var pcdp) ? pcdp.GetString() ?? "" : "";
                                    <div class="form-control form-control-lg bg-light border-0 fw-semibold text-primary d-flex align-items-center">
                                        <i class="bi bi-folder-check me-2"></i> @pNm @(!string.IsNullOrEmpty(pCd) ? $"({pCd})" : "")
                                    </div>
                                    <input type="hidden" value="@ticketModel.ProjectId" />
                                }
                                else
                                {
                                    <select class="form-select form-select-lg bg-light border-0" value="@ticketModel.ProjectId" @onchange="OnProjectSelected" required>
                                        <option value="" disabled selected>-- Select a Project --</option>
                                        @foreach(var project in projects)
                                        {
                                            var pId = project.TryGetProperty("project_id", out var pidp) ? pidp.GetString() ?? "" : "";
                                            var pNm = project.TryGetProperty("name", out var pnmp) ? pnmp.GetString() ?? "" : "";
                                            var pCd = project.TryGetProperty("code", out var pcdp) ? pcdp.GetString() ?? "" : "";
                                            <option value="@pId">@pNm (@pCd)</option>
                                        }
                                    </select>
                                }
                            </div>
                            <div class="col-12 col-sm-6 @(isClient ? "col-md-4" : "col-md-3")">
                                <label class="form-label fw-bold text-dark small mb-2">
                                    <i class="bi bi-diagram-3 text-primary me-1"></i> Module / Dept
                                </label>
                                <select class="form-select form-select-lg bg-light border-0" @bind="ticketModel.ModuleId">
                                    <option value="">-- General / Whole Project --</option>
                                    @foreach(var mod in projectModules)
                                    {
                                        var mId = mod.TryGetProperty("module_id", out var midp) ? midp.GetString() ?? "" : "";
                                        var mNm = mod.TryGetProperty("name", out var mnmp) ? mnmp.GetString() ?? "" : "";
                                        var mCd = mod.TryGetProperty("code", out var mcdp) ? mcdp.GetString() ?? "" : "";
                                        <option value="@mId">@mNm (@mCd)</option>
                                    }
                                </select>
                            </div>
                            @if (!isClient)
                            {
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label fw-bold text-dark small mb-2">
                                        <i class="bi bi-person-check text-success me-1"></i> Assign To User / PM
                                    </label>
                                    <select class="form-select form-select-lg bg-light border-0" @bind="ticketModel.AssignedToUserId">
                                        <option value="">-- Unassigned / Auto-Route --</option>
                                        @foreach(var u in assignableUsers)
                                        {
                                            var uId = u.TryGetProperty("user_id", out var uidp) ? uidp.GetString() : (u.TryGetProperty("id", out var idp) ? idp.GetString() : "");
                                            var uNm = u.TryGetProperty("full_name", out var unmp) ? unmp.GetString() : (u.TryGetProperty("name", out var nmp) ? nmp.GetString() : "");
                                            var uRole = u.TryGetProperty("role", out var urlp) ? urlp.GetString() : "";
                                            <option value="@uId">@uNm (@uRole)</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div class="col-12 col-sm-6 @(isClient ? "col-md-4" : "col-md-3")">
                                <label class="form-label fw-bold text-dark small mb-2">Priority <span class="text-danger">*</span></label>
                                <select class="form-select form-select-lg bg-light border-0" @bind="ticketModel.Priority" required>
                                    <option value="LOW">🔵 Low</option>
                                    <option value="MEDIUM">🟢 Medium</option>
                                    <option value="HIGH">🟠 High</option>
                                    <option value="CRITICAL">🔴 Critical</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small mb-2">Subject / Issue Summary <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg bg-light border-0" placeholder="Briefly describe the problem..." @bind="ticketModel.Subject" required />
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold text-dark small mb-0">Detailed Description <span class="text-danger">*</span></label>
                                <span class="small text-muted">@(ticketModel.Description?.Length ?? 0) characters</span>
                            </div>
                            <textarea class="form-control form-control-lg bg-light border-0" rows="6" placeholder="Please provide detailed steps to reproduce, errors, expected behavior..." @bind="ticketModel.Description" @bind:event="oninput" required></textarea>
                            <div class="form-text mt-1 text-muted small"><i class="bi bi-info-circle me-1"></i>Specific error messages and reproduction steps help the team resolve tickets faster.</div>
                        </div>
                        
                        <div class="mb-5">
                            <label class="form-label fw-bold text-dark small mb-2"><i class="bi bi-image me-1"></i> Screenshot / Attachments (Optional)</label>
                            <InputFile class="form-control form-control-lg bg-light border-0" OnChange="HandleFilesSelected" accept="image/*" multiple />
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div class="form-text"><small>Max 5 files, 5MB each</small></div>
                                @if (selectedAttachments.Count > 0)
                                {
                                    <span class="badge bg-primary">@selectedAttachments.Count file(s) attached</span>
                                }
                            </div>
                        </div>

                        <div class="d-flex flex-column-reverse flex-sm-row align-items-stretch align-items-sm-center justify-content-between gap-3 pt-3 border-top">
                            <button type="button" class="btn btn-link text-muted text-decoration-none fw-semibold" @onclick='() => NavigationManager.NavigateTo("/")'>
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </button>
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm" disabled="@isSubmitting">
                                @if(isSubmitting) { 
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> 
                                    <span>Submitting...</span>
                                } else {
                                    <span>Submit Ticket <i class="bi bi-send ms-2"></i></span>
                                }
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap');

    .container-fluid {
        font-family: 'Outfit', sans-serif;
    }
    
    .glass-card {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    }

    .icon-badge {
        background-color: #eff6ff;
        color: #2563eb;
    }

    .form-control:focus, .form-select:focus {
        background-color: #fff !important;
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15) !important;
    }

    .btn-primary {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        border: none;
        transition: all 0.2s ease;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.35) !important;
    }
</style>

@code {
    private TicketCreateModel ticketModel = new() { Priority = "MEDIUM" };
    private List<JsonElement> projects = new();
    private List<JsonElement> projectModules = new();
    private bool isSubmitting = false;
    private bool isSuccess = false;
    private string errorMessage = "";
    private string generatedTicketNum = "";

    public class SelectedFileAttachment
    {
        public string FileName { get; set; } = "";
        public string MimeType { get; set; } = "";
        public string Base64Data { get; set; } = "";
    }
    private List<SelectedFileAttachment> selectedAttachments = new();

    private string tenantId = "";
    private string userId = "";
    private string role = "";
    private bool isClient => role == "ClientUser" || role == "ClientAdmin";

    public class TicketCreateModel
    {
        public string ProjectId { get; set; } = "";
        public string ModuleId { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Priority { get; set; } = "";
        public string Description { get; set; } = "";
        public string AssignedToUserId { get; set; } = "";
    }

    private List<JsonElement> assignableUsers = new();

    private async Task LoadAssignableUsers(string projId)
    {
        assignableUsers.Clear();
        try
        {
            var payload = new APIDataAccParms
            {
                ProcID = "GET_USERS",
                ComCod = string.IsNullOrEmpty(tenantId) ? "0000" : tenantId,
                parm01 = projId,
                parm04 = userId,
                parm05 = role
            };
            var res = await BackendApi.FetchDataAsync(payload);
            if (res.HasValue)
            {
                void AddUser(JsonElement el)
                {
                    if (el.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var s in el.EnumerateArray()) AddUser(s);
                    }
                    else if (el.ValueKind == JsonValueKind.Object)
                    {
                        if (el.TryGetProperty("Table", out var t) && t.ValueKind == JsonValueKind.Array)
                            foreach (var s in t.EnumerateArray()) AddUser(s);
                        else if (el.TryGetProperty("data", out var d) && d.ValueKind == JsonValueKind.Array)
                            foreach (var s in d.EnumerateArray()) AddUser(s);
                        else if (el.TryGetProperty("user_id", out _) || el.TryGetProperty("id", out _) || el.TryGetProperty("username", out _))
                            assignableUsers.Add(el);
                    }
                }
                AddUser(res.Value);
            }
        }
        catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            role = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
            tenantId = user.FindFirst("TenantId")?.Value 
                ?? user.FindFirst("tenant_id")?.Value 
                ?? "";
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value 
                ?? user.FindFirst("id")?.Value 
                ?? user.FindFirst("userId")?.Value 
                ?? user.FindFirst(ClaimTypes.Name)?.Value 
                ?? user.Identity?.Name 
                ?? "";

            projects.Clear();
            var payload = new APIDataAccParms 
            { 
                ComCod = (role == "SuperAdmin" || role == "MD" || role == "SupportManager" || role == "ProjectManager") ? "" : tenantId,
                ProcID = "GET_PROJECTS",
                parm04 = userId,
                parm05 = role
            };
            
            var result = await BackendApi.FetchDataAsync(payload);
            if (result.HasValue)
            {
                try {
                    void ExtractProjects(JsonElement el)
                    {
                        if (el.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var s in el.EnumerateArray()) ExtractProjects(s);
                        }
                        else if (el.ValueKind == JsonValueKind.Object)
                        {
                            if (el.TryGetProperty("Table", out var tbl) && tbl.ValueKind == JsonValueKind.Array)
                                foreach (var s in tbl.EnumerateArray()) ExtractProjects(s);
                            else if (el.TryGetProperty("data", out var dt) && dt.ValueKind == JsonValueKind.Array)
                                foreach (var s in dt.EnumerateArray()) ExtractProjects(s);
                            else if (el.TryGetProperty("project_id", out _) || el.TryGetProperty("id", out _) || el.TryGetProperty("name", out _))
                                projects.Add(el);
                        }
                    }
                    ExtractProjects(result.Value);
                } catch { } 
                
                if (projects.Count > 0 && string.IsNullOrEmpty(ticketModel.ProjectId))
                {
                    ticketModel.ProjectId = projects[0].TryGetProperty("project_id", out var pid) ? pid.GetString() ?? "" : "";
                    if (!string.IsNullOrEmpty(ticketModel.ProjectId))
                    {
                        await LoadProjectModules(ticketModel.ProjectId);
                        await LoadAssignableUsers(ticketModel.ProjectId);
                    }
                }

                var userMod = user.FindFirst("ModuleId")?.Value ?? user.FindFirst("module_id")?.Value ?? "";
                if (!string.IsNullOrEmpty(userMod))
                {
                    ticketModel.ModuleId = userMod;
                }
            }
        }
    }

    private async Task OnProjectSelected(ChangeEventArgs e)
    {
        ticketModel.ProjectId = e.Value?.ToString() ?? "";
        ticketModel.ModuleId = "";
        ticketModel.AssignedToUserId = "";
        await LoadProjectModules(ticketModel.ProjectId);
        await LoadAssignableUsers(ticketModel.ProjectId);
    }

    private async Task LoadProjectModules(string projId)
    {
        projectModules.Clear();
        if (string.IsNullOrEmpty(projId)) return;

        var payload = new APIDataAccParms
        {
            ProcID = "GET_PROJECT_MODULES",
            parm01 = projId,
            parm04 = userId,
            parm05 = role
        };

        var result = await BackendApi.FetchDataAsync(payload);
        if (result.HasValue)
        {
            try {
                if (result.Value.ValueKind == JsonValueKind.Array)
                {
                    foreach (var el in result.Value.EnumerateArray()) projectModules.Add(el);
                }
                else if (result.Value.TryGetProperty("module_id", out _))
                {
                    projectModules.Add(result.Value);
                }
            } catch { }

            // Check if user is pre-assigned to a specific module in this project
            await TryPreselectUserModule();
        }
    }

    private async Task TryPreselectUserModule()
    {
        if (projectModules.Count == 0) return;

        try {
            var payload = new APIDataAccParms { ProcID = "GET_USERS", ComCod = tenantId, parm05 = role };
            var res = await BackendApi.FetchDataAsync(payload);
            if (res.HasValue && res.Value.ValueKind == JsonValueKind.Array)
            {
                foreach(var u in res.Value.EnumerateArray())
                {
                    if (u.TryGetProperty("user_id", out var uid) && uid.GetString() == userId)
                    {
                        if (u.TryGetProperty("module_id", out var mid) && mid.ValueKind == JsonValueKind.String)
                        {
                            var userModId = mid.GetString();
                            if (!string.IsNullOrEmpty(userModId) && projectModules.Any(m => m.TryGetProperty("module_id", out var pmid) && pmid.GetString() == userModId))
                            {
                                ticketModel.ModuleId = userModId;
                            }
                        }
                        break;
                    }
                }
            }
        } catch { }
    }

    private async Task SubmitTicket()
    {
        if (string.IsNullOrWhiteSpace(ticketModel.ProjectId))
        {
            errorMessage = "Please select a project before submitting.";
            return;
        }

        isSubmitting = true;
        errorMessage = "";
        isSuccess = false;

        try
        {
            var jsonbExtendedData = JsonSerializer.Serialize(new
            {
                detailed_description = ticketModel.Description,
                module_id = ticketModel.ModuleId,
                assigned_to = ticketModel.AssignedToUserId,
                environment = "Dynamic Client UI",
                submitted_from = "SupportHub Client Portal"
            });

            var effectiveComCod = string.IsNullOrEmpty(tenantId) ? "0000" : tenantId;
            var param = new APIDataAccParms
            {
                ComCod = effectiveComCod,
                ProcID = "CREATE_TICKET",            
                parmJson1 = jsonbExtendedData,       
                parm01 = ticketModel.ProjectId,      
                parm02 = ticketModel.Subject,        
                parm03 = ticketModel.Priority,       
                parm04 = userId,
                parm05 = role,
                parm06 = ticketModel.Description,
                parm07 = ticketModel.ModuleId,
                parm08 = ticketModel.AssignedToUserId
            };

            var result = await BackendApi.FetchDataAsync(param);

            JsonElement rootEl = default;
            if (result.HasValue)
            {
                var val = result.Value;
                if (val.ValueKind == JsonValueKind.Object)
                {
                    if (val.TryGetProperty("Table", out var tbl) && tbl.ValueKind == JsonValueKind.Array && tbl.GetArrayLength() > 0)
                        rootEl = tbl[0];
                    else if (val.TryGetProperty("data", out var dt) && dt.ValueKind == JsonValueKind.Array && dt.GetArrayLength() > 0)
                        rootEl = dt[0];
                    else
                        rootEl = val;
                }
                else if (val.ValueKind == JsonValueKind.Array && val.GetArrayLength() > 0)
                {
                    rootEl = val[0];
                }
            }

            bool isOpSuccess = false;
            if (rootEl.ValueKind == JsonValueKind.Object)
            {
                if (rootEl.TryGetProperty("success", out var successEl))
                {
                    isOpSuccess = successEl.ValueKind switch
                    {
                        JsonValueKind.True => true,
                        JsonValueKind.Number => successEl.GetInt64() != 0,
                        JsonValueKind.String => successEl.GetString() == "1" || string.Equals(successEl.GetString(), "true", StringComparison.OrdinalIgnoreCase),
                        _ => false
                    };
                }
                else if (rootEl.TryGetProperty("ticket_number", out _) || rootEl.TryGetProperty("ticket_id", out _) || rootEl.TryGetProperty("id", out _) || rootEl.TryGetProperty("number", out _))
                {
                    isOpSuccess = true;
                }
            }

            if (isOpSuccess)
            {
                generatedTicketNum = rootEl.TryGetProperty("ticket_number", out var numEl) 
                    ? (numEl.GetString() ?? "TIC-" + DateTime.Now.ToString("yyyyMMddHHmmss")) 
                    : (rootEl.TryGetProperty("ticket_id", out var tidEl) 
                        ? (tidEl.GetString() ?? "TIC-" + DateTime.Now.ToString("yyyyMMddHHmmss")) 
                        : "TIC-" + DateTime.Now.ToString("yyyyMMddHHmmss"));
                
                // If user/PM assignment was selected, trigger explicit assignment
                if (!string.IsNullOrEmpty(ticketModel.AssignedToUserId))
                {
                    try
                    {
                        var assignPayload = new APIDataAccParms
                        {
                            ComCod = effectiveComCod,
                            ProcID = "ASSIGN_TICKET",
                            parm01 = generatedTicketNum,
                            parm02 = ticketModel.AssignedToUserId,
                            parm04 = userId,
                            parm05 = role
                        };
                        await BackendApi.FetchDataAsync(assignPayload);
                    }
                    catch { }
                }

                // Upload all selected attachments
                foreach (var att in selectedAttachments)
                {
                    try {
                        var filePayload = new APIDataAccParms
                        {
                            ComCod = effectiveComCod, ProcID = "UPLOAD_FILE", ProcName = "support.sp_ticket_files", 
                            parmJson1 = att.Base64Data, parm06 = att.Base64Data, parm01 = generatedTicketNum, parm02 = att.FileName, parm03 = att.MimeType,
                            parm04 = userId, parm05 = role
                        };
                        await BackendApi.FetchDataAsync(filePayload);
                    } catch { }
                }
                selectedAttachments.Clear();

                isSuccess = true;
                ticketModel = new() { Priority = "MEDIUM", ProjectId = "", ModuleId = "", Subject = "", Description = "", AssignedToUserId = "" };
            }
            else
            {
                var serverError = "API rejected the operation.";
                if (rootEl.ValueKind == JsonValueKind.Object)
                {
                    if (rootEl.TryGetProperty("error", out var e) && !string.IsNullOrEmpty(e.GetString())) serverError = e.GetString()!;
                    else if (rootEl.TryGetProperty("errormessage", out var em) && !string.IsNullOrEmpty(em.GetString())) serverError = em.GetString()!;
                    else if (rootEl.TryGetProperty("message", out var msg) && !string.IsNullOrEmpty(msg.GetString())) serverError = msg.GetString()!;
                }
                errorMessage = "Failed to create the ticket. " + serverError;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "A connection error occurred: " + ex.Message;
        }

        isSubmitting = false;
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        selectedAttachments.Clear();
        foreach (var file in e.GetMultipleFiles(5))
        {
            if (file != null && file.Size <= 1024 * 1024 * 5)
            {
                using var stream = file.OpenReadStream(1024 * 1024 * 5);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                selectedAttachments.Add(new SelectedFileAttachment
                {
                    FileName = file.Name,
                    MimeType = file.ContentType,
                    Base64Data = Convert.ToBase64String(ms.ToArray())
                });
            }
        }
    }
}
