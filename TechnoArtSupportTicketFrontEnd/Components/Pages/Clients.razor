@page "/admin/clients"
@using Microsoft.AspNetCore.Components.Authorization
@using TechnoArtSupportTicketFrontEnd.Services
@using System.Text.Json
@attribute [Authorize(Roles = "SuperAdmin,MD")]
@inject ApiService BackendApi

<PageTitle>Client & Tenant Management</PageTitle>

<div class="custom-card p-3 p-md-4 h-100" style="max-width: 100%; overflow-x: hidden;">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4 border-bottom pb-3">
        <h5 class="fw-bold m-0"><i class="bi bi-building text-primary me-2"></i> Client / Tenant Directory</h5>
        <AuthorizeView Roles="SuperAdmin">
            <div>
                <button class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-semibold shadow-sm text-nowrap d-inline-flex align-items-center" @onclick="ToggleAddMode">
                    <i class="bi @(isAddMode ? "bi-x-lg" : "bi-plus-lg") me-1"></i> @(isAddMode ? "Cancel" : "Add New Client")
                </button>
            </div>
        </AuthorizeView>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-@statusClass alert-dismissible fade show mb-3" role="alert">
            <i class="bi @(statusClass == "success" ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>@statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    @if (isAddMode)
    {
        <div class="card bg-light border-primary mb-4 shadow-sm border-0 border-start border-4">
            <div class="card-body p-3 p-md-4">
                <h6 class="fw-bold mb-3 text-primary">@(string.IsNullOrEmpty(editClientId) ? "Register New Tenant Company" : "Edit Tenant Company")</h6>
                <form @onsubmit="CreateClient">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold">Company Full Name</label>
                            <input type="text" class="form-control" @bind="newClientName" required placeholder="e.g. Pirthe Limited" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold">Tenant Code</label>
                            <input type="text" class="form-control" @bind="newClientCode" required placeholder="e.g. C-1004" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small fw-semibold">Logo URL</label>
                            <input type="text" class="form-control" @bind="newClientLogo" placeholder="e.g. https://pirthe.com/logo.png" />
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-light border" @onclick="ToggleAddMode">Cancel</button>
                        <button type="submit" class="btn btn-success fw-semibold" disabled="@isSubmitting">
                            @if(isSubmitting) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            @(string.IsNullOrEmpty(editClientId) ? "Save Client" : "Update Client")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle" style="min-width: 650px;">
            <thead class="bg-light text-muted small text-uppercase">
                <tr>
                    <th>Logo</th>
                    <th>Tenant ID</th>
                    <th>Client Name</th>
                    <th>Tenant Code</th>
                    <th>Status</th>
                    <th class="text-end text-nowrap">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr><td colspan="6" class="text-center p-4"><div class="spinner-border text-primary"></div></td></tr>
                }
                else if (clientList != null && clientList.Count > 0)
                {
                    foreach (var client in clientList)
                    {
                        var logo = client.TryGetProperty("logo_url", out var l) && l.ValueKind == JsonValueKind.String ? l.GetString() : null;
                        var cId = client.TryGetProperty("tenant_id", out var cidp) ? cidp.GetString() ?? "" : (client.TryGetProperty("id", out var idp) ? idp.GetString() ?? "" : "");
                        var cName = client.TryGetProperty("name", out var cnmp) ? cnmp.GetString() ?? "" : "";
                        var cCode = client.TryGetProperty("code", out var ccdp) ? ccdp.GetString() ?? "" : "";
                        var displayTenantId = cId.Length > 12 ? ("T-" + cId[..8]) : cId;
                        var isDefaultTenant = cId == "000000000001" || cId == "T00000000001" || cId == "00000000-0000-0000-0000-000000000000";
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(logo))
                                {
                                    <img src="@logo" alt="Logo" style="height:30px;max-width:100px;object-fit:contain;" />
                                }
                                else
                                {
                                    <div class="avatar-circle bg-secondary text-white" style="width:30px;height:30px;font-size:0.8rem;">@(string.IsNullOrEmpty(cName) ? "?" : cName[..1])</div>
                                }
                            </td>
                            <td class="font-monospace"><span class="badge bg-light text-primary border font-monospace fw-bold px-2 py-1">@displayTenantId</span></td>
                            <td class="fw-bold">@cName</td>
                            <td><span class="badge bg-light text-dark border">@cCode</span></td>
                            <td><span class="dot dot-green me-1"></span> Active</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" @onclick='() => StartEditClient(cId, cName, cCode, logo)' title="Edit Client"><i class="bi bi-pencil"></i></button>
                                @if (!isDefaultTenant)
                                {
                                    <AuthorizeView Roles="SuperAdmin">
                                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick='() => ConfirmDelete(cId, cName)' title="Delete Client"><i class="bi bi-trash"></i></button>
                                    </AuthorizeView>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted p-4">No clients registered yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Client</h5>
                    <button type="button" class="btn-close" @onclick="() => showDeleteModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p>Are you sure you want to delete client <strong>@deleteClientName</strong>?</p>
                    <p class="text-muted small">Note: Clients with open tickets or associated active records cannot be deleted until those tickets are resolved.</p>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light" @onclick="() => showDeleteModal = false">Cancel</button>
                    <button type="button" class="btn btn-danger fw-semibold" @onclick="ExecuteDeleteClient" disabled="@isSubmitting">
                        @if (isSubmitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Delete Permanently
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<JsonElement> clientList = new();
    private bool isLoading = true;
    private bool isAddMode = false;
    private bool isSubmitting = false;

    private string newClientName = "";
    private string newClientCode = "";
    private string newClientLogo = "";
    
    private string? editClientId = null;
    private string? statusMessage = null;
    private string statusClass = "success";

    private bool showDeleteModal = false;
    private string deleteClientId = "";
    private string deleteClientName = "";

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
        await LoadClients();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && (clientList == null || clientList.Count == 0))
        {
            await LoadClients();
            StateHasChanged();
        }
    }

    private static void ExtractItems(JsonElement element, Action<JsonElement> onObject)
    {
        if (element.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in element.EnumerateArray()) ExtractItems(item, onObject);
        }
        else if (element.ValueKind == JsonValueKind.Object)
        {
            if (element.TryGetProperty("Table", out var tbl) && tbl.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in tbl.EnumerateArray()) ExtractItems(item, onObject);
            }
            else if (element.TryGetProperty("data", out var dt) && dt.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in dt.EnumerateArray()) ExtractItems(item, onObject);
            }
            else
            {
                onObject(element);
            }
        }
    }

    private async Task LoadClients()
    {
        isLoading = true;
        clientList.Clear();
        var payload = new APIDataAccParms { ProcID = "GET_TENANTS" };
        var result = await BackendApi.FetchDataAsync(payload);
        
        if (result.HasValue)
        {
            try {
                ExtractItems(result.Value, el =>
                {
                    if (el.ValueKind == JsonValueKind.Object && (el.TryGetProperty("tenant_id", out _) || el.TryGetProperty("name", out _) || el.TryGetProperty("id", out _)))
                    {
                        var cid = el.TryGetProperty("tenant_id", out var cp) && cp.ValueKind == JsonValueKind.String ? cp.GetString() : (el.TryGetProperty("id", out var ip) && ip.ValueKind == JsonValueKind.String ? ip.GetString() : null);
                        if (!string.IsNullOrEmpty(cid))
                        {
                            if (!clientList.Any(x => (x.ValueKind == JsonValueKind.Object && x.TryGetProperty("tenant_id", out var xc) && xc.GetString() == cid) || (x.ValueKind == JsonValueKind.Object && x.TryGetProperty("id", out var xi) && xi.GetString() == cid)))
                            {
                                clientList.Add(el);
                            }
                        }
                        else
                        {
                            clientList.Add(el);
                        }
                    }
                });
            } catch {}
        }
        isLoading = false;
        StateHasChanged();
    }

    private void ToggleAddMode() {
        isAddMode = !isAddMode;
        if(isAddMode) {
            editClientId = null;
            newClientCode = "T" + (clientList.Count + 1).ToString("D10");
            newClientName = "";
            newClientLogo = "";
        }
    }
    
    private void StartEditClient(string? id, string? name, string? code, string? logo)
    {
        editClientId = id;
        newClientName = name ?? "";
        newClientCode = code ?? "";
        newClientLogo = logo ?? "";
        isAddMode = true;
    }

    private void ConfirmDelete(string id, string name)
    {
        deleteClientId = id;
        deleteClientName = name;
        showDeleteModal = true;
    }

    private async Task ExecuteDeleteClient()
    {
        if (string.IsNullOrEmpty(deleteClientId)) return;
        isSubmitting = true;
        statusMessage = null;

        var payload = new APIDataAccParms
        {
            ProcID = "DELETE_TENANT",
            parm01 = deleteClientId
        };

        var result = await BackendApi.FetchDataAsync(payload);
        showDeleteModal = false;
        isSubmitting = false;

        var resEl = result.HasValue ? (result.Value.ValueKind == JsonValueKind.Array && result.Value.GetArrayLength() > 0 ? result.Value[0] : result.Value) : default;
        if (result.HasValue && resEl.ValueKind == JsonValueKind.Object && resEl.TryGetProperty("error", out var err) && !string.IsNullOrEmpty(err.GetString()))
        {
            statusMessage = err.GetString();
            statusClass = "danger";
        }
        else
        {
            statusMessage = $"Client '{deleteClientName}' deleted successfully.";
            statusClass = "success";
            await LoadClients();
        }
    }

    private async Task CreateClient()
    {
        isSubmitting = true;
        statusMessage = null;
        var payload = new APIDataAccParms 
        { 
            ProcID = string.IsNullOrEmpty(editClientId) ? "CREATE_TENANT" : "UPDATE_TENANT",
            parm01 = string.IsNullOrEmpty(editClientId) ? newClientCode : editClientId,
            parm02 = newClientName,
            parm03 = newClientCode,
            parm04 = newClientLogo,
            parm06 = newClientLogo
        };

        var res = await BackendApi.FetchDataAsync(payload);
        
        var resEl = res.HasValue ? (res.Value.ValueKind == JsonValueKind.Array && res.Value.GetArrayLength() > 0 ? res.Value[0] : res.Value) : default;
        if (res.HasValue && resEl.ValueKind == JsonValueKind.Object && resEl.TryGetProperty("error", out var err) && !string.IsNullOrEmpty(err.GetString()))
        {
            statusMessage = err.GetString();
            statusClass = "danger";
            isSubmitting = false;
            return;
        }

        statusMessage = string.IsNullOrEmpty(editClientId) ? "Client registered successfully!" : "Client updated successfully!";
        statusClass = "success";

        // Reset form and reload
        isAddMode = false;
        newClientName = "";
        newClientCode = "";
        newClientLogo = "";
        editClientId = null;
        isSubmitting = false;
        await LoadClients();
    }
}
