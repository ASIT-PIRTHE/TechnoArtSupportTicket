@page "/settings"
@using Microsoft.AspNetCore.Components.Authorization
@using TechnoArtSupportTicketFrontEnd.Services
@using System.Security.Claims
@using System.Text.Json
@attribute [Authorize]
@inject ApiService BackendApi
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>User Settings & Profile - SupportHub</PageTitle>

<div class="row g-4">
    <!-- User Profile Header Card -->
    <div class="col-12">
        <div class="custom-card p-3 p-md-4 border-0 shadow-sm bg-primary text-white position-relative overflow-hidden">
            <div class="d-flex flex-column flex-sm-row align-items-center text-center text-sm-start gap-3 gap-md-4 position-relative" style="z-index: 2;">
                <div class="avatar-circle-lg bg-white text-primary fw-bold display-6 rounded-circle d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                    @(string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper())
                </div>
                <div>
                    <h3 class="fw-bold mb-1">@fullName</h3>
                    <div class="d-flex flex-wrap justify-content-center justify-content-sm-start align-items-center gap-2 opacity-75 small">
                        <span><i class="bi bi-person-badge me-1"></i> User ID: <strong>@userId</strong></span>
                        <span>•</span>
                        <span><i class="bi bi-shield-check me-1"></i> Role: <strong>@role</strong></span>
                        <span>•</span>
                        <span><i class="bi bi-building me-1"></i> Tenant: <strong>@tenantName</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Profile & Password Form -->
    <div class="col-lg-7">
        <div class="custom-card p-3 p-md-4 h-100 shadow-sm border-0">
            <h5 class="fw-bold mb-4 text-primary border-bottom pb-3">
                <i class="bi bi-person-gear me-2"></i> Account Information & Security
            </h5>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert alert-@statusClass alert-dismissible fade show" role="alert">
                    @statusMessage
                    <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
                </div>
            }

            <form @onsubmit="SaveSettings">
                <div class="mb-4">
                    <label class="form-label fw-semibold text-muted small">Full Name</label>
                    <input type="text" class="form-control bg-light" @bind="fullName" required placeholder="Enter full name" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold text-muted small">Username / User ID (Read-only)</label>
                    <input type="text" class="form-control bg-light" value="@username" disabled />
                </div>

                <hr class="my-4 text-muted opacity-25" />

                <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-key me-2"></i> Change Password</h6>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small">New Password</label>
                    <input type="password" class="form-control bg-light" @bind="newPassword" placeholder="Leave blank to keep current password" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold text-muted small">Confirm New Password</label>
                    <input type="password" class="form-control bg-light" @bind="confirmPassword" placeholder="Re-enter new password" />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-primary fw-semibold px-4" disabled="@isSaving">
                        @if(isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Mobile App QR Linking & 2FA -->
    <div class="col-lg-5">
        <div class="custom-card p-3 p-md-4 h-100 shadow-sm border-0">
            <h5 class="fw-bold mb-3 text-primary border-bottom pb-3">
                <i class="bi bi-qr-code-scan me-2"></i> Mobile App & QR Binding
            </h5>

            <p class="text-muted small">
                Link your SupportHub mobile app to enable instant WhatsApp-style QR login and biometric 2FA authentication.
            </p>

            <div class="text-center bg-light p-4 rounded-4 my-4 border border-dashed">
                <div class="qr-container p-3 bg-white rounded-3 shadow-sm d-inline-block">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=SUPPORTHUB-BIND-@userId" alt="Device Binding QR" class="img-fluid rounded" />
                </div>
                <div class="mt-3 text-primary fw-semibold small">
                    <i class="bi bi-phone me-1"></i> Scan with SupportHub Mobile App
                </div>
                <div class="text-muted style-italic" style="font-size: 0.75rem;">
                    Binding Key: SUPPORTHUB-BIND-@userId
                </div>
            </div>

            <div class="card border-0 bg-light-surface p-3 rounded-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-semibold small"><i class="bi bi-shield-check text-success me-1"></i> QR Web Login</span>
                    <span class="badge bg-success">Active</span>
                </div>
                <div class="text-muted style-italic" style="font-size: 0.75rem;">
                    When enabled, scanning the web QR code from your mobile app logs you in automatically without typing a password.
                </div>
            </div>
        </div>
    </div>

    <!-- My Managed & Assigned Projects Card -->
    <div class="col-12">
        <div class="custom-card p-3 p-md-4 shadow-sm border-0">
            <h5 class="fw-bold mb-3 text-primary border-bottom pb-3">
                <i class="bi bi-kanban me-2"></i> My Managed & Assigned Projects
            </h5>
            @if (isLoadingProjects)
            {
                <div class="text-center p-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
            }
            else if (myProjects.Count > 0)
            {
                <div class="row g-3">
                    @foreach (var proj in myProjects)
                    {
                        var pCode = proj.TryGetProperty("code", out var c) ? c.GetString() : "";
                        var pName = proj.TryGetProperty("name", out var n) ? n.GetString() : "";
                        var tName = proj.TryGetProperty("tenant_name", out var tn) ? tn.GetString() : "Internal";
                        var pmName = proj.TryGetProperty("pm_name", out var pm) ? pm.GetString() : "";
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="border rounded p-3 bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-primary">@pCode</span>
                                    @if (!string.IsNullOrEmpty(pmName) && (pmName.Equals(fullName, StringComparison.OrdinalIgnoreCase) || pmName.Equals(username, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <span class="badge bg-success">Project Manager</span>
                                    }
                                </div>
                                <h6 class="fw-bold mb-1">@pName</h6>
                                <div class="small text-muted mb-1"><i class="bi bi-building me-1"></i>@tName</div>
                                <div class="small text-muted"><i class="bi bi-person-badge text-primary me-1"></i>PM: <strong>@(string.IsNullOrEmpty(pmName) ? "Unassigned" : pmName)</strong></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">No active projects currently assigned to your account.</p>
            }
        </div>
    </div>
</div>

@code {
    private string userId = "";
    private string username = "";
    private string fullName = "";
    private string role = "";
    private string tenantId = "";
    private string tenantName = "SupportHub Enterprise";

    private string newPassword = "";
    private string confirmPassword = "";

    private bool isSaving = false;
    private string? statusMessage;
    private string statusClass = "success";

    private List<JsonElement> myProjects = new();
    private bool isLoadingProjects = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            username = user.Identity.Name ?? "";
            role = user.FindFirst(ClaimTypes.Role)?.Value ?? "";
            tenantId = user.FindFirst("TenantId")?.Value ?? "";
            userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
            fullName = user.FindFirst("FullName")?.Value ?? username;

            if (string.IsNullOrEmpty(fullName)) fullName = username;

            await LoadTenantName();
            await LoadMyProjects();
        }
    }

    private async Task LoadTenantName()
    {
        if (string.IsNullOrEmpty(tenantId) || tenantId == "00000000-0000-0000-0000-000000000000")
        {
            tenantName = "Global / Internal System";
            return;
        }

        try
        {
            var p = new APIDataAccParms { ProcID = "GET_TENANTS" };
            var res = await BackendApi.FetchDataAsync(p);
            if (res.HasValue && res.Value.ValueKind == JsonValueKind.Array)
            {
                foreach (var el in res.Value.EnumerateArray())
                {
                    if (el.TryGetProperty("tenant_id", out var tid) && tid.GetString() == tenantId)
                    {
                        if (el.TryGetProperty("name", out var tname) && !string.IsNullOrEmpty(tname.GetString()))
                        {
                            tenantName = tname.GetString()!;
                            return;
                        }
                    }
                }
            }
        }
        catch {}
    }

    private async Task LoadMyProjects()
    {
        isLoadingProjects = true;
        myProjects.Clear();
        var payload = new APIDataAccParms
        {
            ProcID = "GET_PROJECTS",
            ComCod = tenantId,
            parm04 = userId,
            parm05 = role
        };
        var result = await BackendApi.FetchDataAsync(payload);
        if (result.HasValue)
        {
            try {
                if (result.Value.ValueKind == JsonValueKind.Array)
                {
                    foreach (var el in result.Value.EnumerateArray()) myProjects.Add(el);
                }
                else if (result.Value.TryGetProperty("project_id", out _))
                {
                    myProjects.Add(result.Value);
                }

                if (role == "ProjectManager")
                {
                    myProjects = myProjects.Where(p => {
                        var pm = p.TryGetProperty("pm_name", out var pmp) ? pmp.GetString() : "";
                        return !string.IsNullOrEmpty(pm) && (pm.Equals(fullName, StringComparison.OrdinalIgnoreCase) || pm.Equals(username, StringComparison.OrdinalIgnoreCase));
                    }).ToList();
                }
            } catch { }
        }
        isLoadingProjects = false;
    }

    private async Task SaveSettings()
    {
        statusMessage = null;

        if (!string.IsNullOrEmpty(newPassword) && newPassword != confirmPassword)
        {
            statusMessage = "New password and confirm password do not match.";
            statusClass = "danger";
            return;
        }

        isSaving = true;

        try
        {
            var payload = new APIDataAccParms
            {
                ComCod = tenantId,
                ProcID = "UPDATE_USER",
                parm01 = userId,
                parm02 = fullName,
                parm03 = role,
                parm04 = "",
                parm05 = tenantId,
                parm06 = string.IsNullOrEmpty(newPassword) ? "" : newPassword
            };

            var res = await BackendApi.FetchDataAsync(payload);

            if (res.HasValue && res.Value.TryGetProperty("error", out var err) && !string.IsNullOrEmpty(err.GetString()))
            {
                statusMessage = err.GetString();
                statusClass = "danger";
            }
            else
            {
                statusMessage = "Profile settings updated successfully!";
                statusClass = "success";
                newPassword = "";
                confirmPassword = "";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error updating settings: {ex.Message}";
            statusClass = "danger";
        }

        isSaving = false;
    }
}
