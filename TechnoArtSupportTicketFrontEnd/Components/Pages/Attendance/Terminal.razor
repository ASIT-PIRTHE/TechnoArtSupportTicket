@page "/attendance/terminal"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using TechnoArtSupportTicketFrontEnd.Services
@using System.Text.Json
@inject ApiService BackendApi
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Attendance Terminal - TechnoArt</PageTitle>

<div class="container-fluid py-2 py-md-4 px-2 px-md-3" style="max-width: 100%; overflow-x: hidden;">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="bi bi-fingerprint me-2"></i> Attendance Terminal
            </h4>
            <p class="text-muted small mb-0">Biometric & GPS-verified Smart Clock-in Terminal</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-6 fw-semibold">
                <i class="bi bi-clock me-1"></i> @currentTime
            </span>
            <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="RefreshLocation" disabled="@isCheckingLocation">
                <i class="bi bi-arrow-clockwise @(isCheckingLocation ? "spin" : "") me-1"></i> Refresh GPS
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i> @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Main Clock Card -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 h-100 overflow-hidden">
                <div class="card-header bg-gradient text-white p-4" style="background: linear-gradient(135deg, #2b3990 0%, #1e2865 100%);">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-uppercase tracking-wider small opacity-75 fw-bold">Live Status</span>
                            <h5 class="fw-bold mb-0 text-white">@currentDateFormatted</h5>
                        </div>
                        <span class="badge @(isWithinRadius || isWfh ? "bg-success" : "bg-warning") px-3 py-2 rounded-pill">
                            <i class="bi @(isWithinRadius || isWfh ? "bi-geo-alt-fill" : "bi-geo-alt") me-1"></i>
                            @(isWfh ? "WFH Active" : (isWithinRadius ? "In Office Hub" : "Outside Perimeter"))
                        </span>
                    </div>
                </div>

                <div class="card-body p-3 p-md-4 text-center">
                    <!-- Big Digital Clock -->
                    <div class="display-3 fw-bold text-dark my-3 font-monospace">@currentTime</div>
                    <div class="text-muted small mb-4">
                        <i class="bi bi-building me-1"></i> Assigned Hub: <strong>@(branchName ?? "Dhaka Main Office")</strong>
                        <span class="mx-2 d-none d-sm-inline">•</span>
                        <div class="d-sm-none my-1"></div>
                        <i class="bi bi-clock-history me-1"></i> Shift: <strong>@(shiftTiming ?? "09:30 AM - 06:30 PM")</strong>
                    </div>

                    <!-- Geolocation & WFH Status Box -->
                    <div class="p-3 mb-4 rounded-3 border @(isWithinRadius ? "bg-success-subtle border-success" : (isWfh ? "bg-info-subtle border-info" : "bg-warning-subtle border-warning")) text-start">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="fw-semibold">
                                <i class="bi @(isWithinRadius ? "bi-check2-circle text-success" : "bi-geo text-danger") me-1"></i>
                                Perimeter Verification
                            </div>
                            <span class="badge @(isWithinRadius ? "bg-success" : "bg-danger")">
                                @(userDistance >= 0 ? $"{Math.Round(userDistance)} m away" : "Detecting...")
                            </span>
                        </div>
                        <div class="small text-muted mb-2">
                            @if (isWfh)
                            {
                                <span><strong class="text-info"><i class="bi bi-house-door me-1"></i>Work From Home Mode:</strong> Geofence perimeter restriction bypassed.</span>
                            }
                            else if (isWithinRadius)
                            {
                                <span>You are inside the permitted radius of <strong>@branchRadius meters</strong> from @branchName.</span>
                            }
                            else
                            {
                                <span class="text-danger">You are currently outside the required @branchRadius-meter radius. Move closer or contact HR for WFH authorization.</span>
                            }
                        </div>

                        <!-- WFH Checkbox -->
                        <div class="form-check form-switch pt-2 border-top">
                            <input class="form-check-input" type="checkbox" id="wfhSwitch" @bind="isWfh">
                            <label class="form-check-label small fw-semibold" for="wfhSwitch">
                                <i class="bi bi-laptop me-1"></i> Work From Home (WFH) Punch Request
                            </label>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row g-2 g-sm-3">
                        <div class="col-12 col-sm-6">
                            <button class="btn btn-success btn-lg w-100 py-3 rounded-3 shadow-sm fw-bold"
                                    disabled="@(isPunching || todayInTime != null || (!isWithinRadius && !isWfh))"
                                    @onclick="HandleCheckIn">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                @(todayInTime != null ? "Punched In" : "Clock In")
                            </button>
                            @if (todayInTime != null)
                            {
                                <div class="small mt-2 text-success fw-semibold">
                                    <i class="bi bi-check-circle me-1"></i> In: @todayInTime
                                    <span class="badge @GetApprovalBadge(inApprovalStatus) ms-1">@inApprovalStatus</span>
                                </div>
                            }
                        </div>
                        <div class="col-12 col-sm-6">
                            <button class="btn btn-danger btn-lg w-100 py-3 rounded-3 shadow-sm fw-bold"
                                    disabled="@(isPunching || todayInTime == null || todayOutTime != null || (!isWithinRadius && !isWfh))"
                                    @onclick="HandleCheckOut">
                                <i class="bi bi-box-arrow-right me-2"></i>
                                @(todayOutTime != null ? "Punched Out" : "Clock Out")
                            </button>
                            @if (todayOutTime != null)
                            {
                                <div class="small mt-2 text-danger fw-semibold">
                                    <i class="bi bi-check-circle me-1"></i> Out: @todayOutTime
                                    <span class="badge @GetApprovalBadge(outApprovalStatus) ms-1">@outApprovalStatus</span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (isPastCutoff)
                    {
                        <div class="alert alert-warning mt-3 py-2 small mb-0">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Notice: Shift standard hours have completed. Late check-out logged.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Today's Summary & Approval Status -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-3 pt-md-4 px-3 px-md-4 pb-0">
                    <h5 class="fw-bold mb-0"><i class="bi bi-card-checklist text-primary me-2"></i> Today's Attendance Overview</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <div class="row g-2 g-sm-3 mb-4">
                        <div class="col-12 col-sm-6">
                            <div class="p-3 rounded-3 bg-light border text-center">
                                <div class="text-muted small text-uppercase fw-bold">Clock-In</div>
                                <div class="fs-4 fw-bold text-success my-1">@(todayInTime ?? "--:--")</div>
                                <span class="badge @GetApprovalBadge(inApprovalStatus)">@(inApprovalStatus ?? "Not Punched")</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="p-3 rounded-3 bg-light border text-center">
                                <div class="text-muted small text-uppercase fw-bold">Clock-Out</div>
                                <div class="fs-4 fw-bold text-danger my-1">@(todayOutTime ?? "--:--")</div>
                                <span class="badge @GetApprovalBadge(outApprovalStatus)">@(outApprovalStatus ?? "Not Punched")</span>
                            </div>
                        </div>
                    </div>

                    <div class="list-group list-group-flush border rounded-3 mb-3">
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="bi bi-geo-alt me-2"></i>Punched Location</span>
                            <span class="fw-semibold">@(userLat > 0 ? $"{userLat:F5}, {userLong:F5}" : "GPS Pending")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="bi bi-shield-check me-2"></i>HR In-Approval</span>
                            <span class="badge @GetApprovalBadge(inApprovalStatus) px-2 py-1">@inApprovalStatus</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="bi bi-shield-check me-2"></i>HR Out-Approval</span>
                            <span class="badge @GetApprovalBadge(outApprovalStatus) px-2 py-1">@outApprovalStatus</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="bi bi-stopwatch me-2"></i>Working Duration</span>
                            <span class="fw-bold text-primary">@calculatedHours</span>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <a href="/attendance/reports" class="btn btn-outline-primary btn-sm flex-fill">
                            <i class="bi bi-calendar-range me-1"></i> View Attendance History
                        </a>
                        <a href="/attendance/leaves" class="btn btn-outline-secondary btn-sm flex-fill">
                            <i class="bi bi-envelope-paper me-1"></i> Apply For Leave
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Log Table -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom py-3 px-3 px-md-4 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0"><i class="bi bi-calendar3 me-2 text-primary"></i> Recent Attendance Records</h6>
            <span class="badge bg-light text-dark border">Current Month</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="min-width: 650px;">
                <thead class="table-light small text-uppercase text-nowrap">
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>In Time</th>
                        <th>Out Time</th>
                        <th>Status</th>
                        <th>HR Approval (In/Out)</th>
                        <th>Method</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentLogs.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i> No attendance punches recorded yet this month.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in recentLogs)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@log.Date</td>
                                <td><span class="text-success fw-bold">@(log.InTime ?? "--:--")</span></td>
                                <td><span class="text-danger fw-bold">@(log.OutTime ?? "--:--")</span></td>
                                <td>
                                    <span class="badge @(log.Status == "ON_TIME" ? "bg-success" : (log.Status == "LATE" ? "bg-warning" : "bg-danger"))">
                                        @log.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @GetApprovalBadge(log.InApproved ? "APPROVED" : "PENDING") me-1">In: @(log.InApproved ? "Approved" : "Pending")</span>
                                    <span class="badge @GetApprovalBadge(log.OutApproved ? "APPROVED" : "PENDING")">Out: @(log.OutApproved ? "Approved" : "Pending")</span>
                                </td>
                                <td>
                                    @if (log.IsWfh)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-house me-1"></i>WFH</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-building me-1"></i>Hub</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .spin {
        animation: rotate 1s linear infinite;
    }
    @@keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private string currentTime = DateTime.Now.ToString("hh:mm:ss tt");
    private string currentDateFormatted = DateTime.Now.ToString("dddd, dd MMMM yyyy");
    private System.Threading.Timer? clockTimer;

    private bool isCheckingLocation = false;
    private bool isPunching = false;
    private bool isPastCutoff = false;
    private bool isWfh = false;
    private bool isWithinRadius = false;
    private double userDistance = -1;

    private double userLat = 0;
    private double userLong = 0;

    // Hub defaults (can be loaded from DB)
    private string branchName = "TechnoArt Headquarters";
    private double branchLat = 23.7925; // Default Dhaka Lat
    private double branchLong = 90.4078; // Default Dhaka Long
    private double branchRadius = 250; // Meters
    private string shiftTiming = "09:30 AM - 06:30 PM";

    private string? statusMessage;
    private bool isSuccess = true;

    private string? todayInTime;
    private string? todayOutTime;
    private string inApprovalStatus = "PENDING";
    private string outApprovalStatus = "PENDING";
    private string calculatedHours = "--";

    private List<AttendanceRow> recentLogs = new();

    public class AttendanceRow
    {
        public string Date { get; set; } = "";
        public string? InTime { get; set; }
        public string? OutTime { get; set; }
        public string Status { get; set; } = "ON_TIME";
        public bool InApproved { get; set; } = false;
        public bool OutApproved { get; set; } = false;
        public bool IsWfh { get; set; } = false;
    }

    public class LocationResult
    {
        public bool Success { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public string? ErrorMessage { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        clockTimer = new System.Threading.Timer(_ =>
        {
            currentTime = DateTime.Now.ToString("hh:mm:ss tt");
            if (DateTime.Now.Hour >= 21) isPastCutoff = true;
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

        await LoadAttendanceStatus();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshLocation();
        }
    }

    private async Task RefreshLocation()
    {
        isCheckingLocation = true;
        statusMessage = null;
        StateHasChanged();

        try
        {
            var loc = await JS.InvokeAsync<LocationResult>("getBrowserLocation");
            if (loc != null && loc.Success)
            {
                userLat = loc.Latitude;
                userLong = loc.Longitude;

                // Calculate distance via JS interop or local formula
                userDistance = await JS.InvokeAsync<double>("calculateHaversineDistance", userLat, userLong, branchLat, branchLong);
                isWithinRadius = userDistance <= branchRadius;

                if (!isWithinRadius && !isWfh)
                {
                    statusMessage = $"You are {Math.Round(userDistance)}m away from office (allowed radius: {branchRadius}m). Enable WFH switch if working remotely.";
                    isSuccess = false;
                }
                else
                {
                    statusMessage = "GPS location verified successfully.";
                    isSuccess = true;
                }
            }
            else
            {
                statusMessage = loc?.ErrorMessage ?? "Failed to acquire GPS location.";
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            statusMessage = "Geolocation error: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isCheckingLocation = false;
            StateHasChanged();
        }
    }

    private async Task LoadAttendanceStatus()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "User";

            var req = new APIDataAccParms
            {
                ProcName = "sp_attendance_operations",
                ProcID = "GET_TODAY_ATTENDANCE",
                parm01 = username,
                parm02 = DateTime.Today.ToString("yyyy-MM-dd")
            };

            var res = await BackendApi.FetchDataAsync(req);
            if (res.HasValue)
            {
                var target = res.Value;
                if (target.ValueKind == JsonValueKind.Array && target.GetArrayLength() > 0) target = target[0];
                if (target.ValueKind == JsonValueKind.Object)
                {
                    if (target.TryGetProperty("in_time", out var inProp) && inProp.GetString() != null)
                    {
                        var rawIn = inProp.GetString();
                        if (DateTime.TryParse(rawIn, out var parsedIn)) todayInTime = parsedIn.ToString("hh:mm tt");
                        else todayInTime = rawIn;
                    }
                    if (target.TryGetProperty("out_time", out var outProp) && outProp.GetString() != null)
                    {
                        var rawOut = outProp.GetString();
                        if (DateTime.TryParse(rawOut, out var parsedOut)) todayOutTime = parsedOut.ToString("hh:mm tt");
                        else todayOutTime = rawOut;
                    }
                    if (target.TryGetProperty("in_approval_status", out var inApp))
                    {
                        inApprovalStatus = inApp.GetString() ?? "PENDING";
                    }
                    if (target.TryGetProperty("out_approval_status", out var outApp))
                    {
                        outApprovalStatus = outApp.GetString() ?? "PENDING";
                    }
                }
            }

            recentLogs = new List<AttendanceRow>
            {
                new AttendanceRow 
                { 
                    Date = DateTime.Today.ToString("MMM dd, yyyy"), 
                    InTime = (!string.IsNullOrEmpty(todayInTime) && todayInTime != "--:--") ? todayInTime : null, 
                    OutTime = (!string.IsNullOrEmpty(todayOutTime) && todayOutTime != "--:--") ? todayOutTime : null, 
                    Status = "ON_TIME", 
                    InApproved = (inApprovalStatus == "APPROVED"), 
                    OutApproved = (outApprovalStatus == "APPROVED"), 
                    IsWfh = isWfh 
                }
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine("Attendance load err: " + ex.Message);
        }
    }

    private async Task HandleCheckIn()
    {
        if (!isWithinRadius && !isWfh)
        {
            statusMessage = "Cannot punch in: Outside permitted office radius.";
            isSuccess = false;
            return;
        }

        isPunching = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Employee";

            var req = new APIDataAccParms
            {
                ProcName = "sp_attendance_checkin",
                ProcID = "CHECK_IN",
                parm01 = username,
                parm02 = DateTime.UtcNow.ToString("o"),
                parm03 = userLat.ToString(),
                parm04 = userLong.ToString(),
                parm05 = isWfh ? "1" : "0"
            };

            var res = await BackendApi.FetchDataAsync(req);
            todayInTime = DateTime.Now.ToString("hh:mm tt");
            inApprovalStatus = "PENDING";
            statusMessage = "Clock-in recorded successfully! HR approval pending.";
            isSuccess = true;
            await LoadAttendanceStatus();
        }
        catch (Exception ex)
        {
            statusMessage = "Check-in error: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isPunching = false;
        }
    }

    private async Task HandleCheckOut()
    {
        isPunching = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "Employee";

            var req = new APIDataAccParms
            {
                ProcName = "sp_attendance_checkout",
                ProcID = "CHECK_OUT",
                parm01 = username,
                parm02 = DateTime.UtcNow.ToString("o"),
                parm03 = userLat.ToString(),
                parm04 = userLong.ToString()
            };

            var res = await BackendApi.FetchDataAsync(req);
            todayOutTime = DateTime.Now.ToString("hh:mm tt");
            outApprovalStatus = "PENDING";
            statusMessage = "Clock-out recorded successfully! HR approval pending.";
            isSuccess = true;
            await LoadAttendanceStatus();
        }
        catch (Exception ex)
        {
            statusMessage = "Check-out error: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isPunching = false;
        }
    }

    private string GetApprovalBadge(string? status)
    {
        return status switch
        {
            "APPROVED" => "bg-success",
            "REJECTED" => "bg-danger",
            _ => "bg-warning text-dark"
        };
    }

    public void Dispose()
    {
        clockTimer?.Dispose();
    }
}
