@page "/attendance/approvals"
@using Microsoft.AspNetCore.Components.Authorization
@using TechnoArtSupportTicketFrontEnd.Services
@using System.Text.Json
@attribute [Authorize(Roles = "SuperAdmin,Admin,MD,HRManager,SupportManager")]
@inject ApiService BackendApi
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Attendance Approvals - HR Portal</PageTitle>

<div class="container-fluid py-2 py-md-4 px-2 px-md-3" style="max-width: 100%; overflow-x: hidden;">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold mb-1 text-primary">
                <i class="bi bi-calendar-check me-2"></i> Attendance Verification & Approvals
            </h4>
            <p class="text-muted small mb-0">Dual In/Out punch verification and WFH validation queue for HR and Management</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary btn-sm rounded-pill px-3 py-2 shadow-sm text-nowrap d-inline-flex align-items-center" @onclick="LoadAttendanceQueue" disabled="@isBusy">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Queue
            </button>
            <button class="btn btn-success btn-sm rounded-pill px-3 py-2 shadow-sm text-nowrap d-inline-flex align-items-center" @onclick="BulkApprovePending" disabled="@(isBusy || !HasPendingVisible)">
                <i class="bi bi-check2-all me-1"></i> Approve All Visible
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi @(isSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i> @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-2 g-sm-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Pending In-Approval</div>
                        <h3 class="fw-bold my-1 text-warning">@pendingInCount</h3>
                        <span class="small text-muted">Awaiting HR In-Punch check</span>
                    </div>
                    <i class="bi bi-box-arrow-in-right fs-1 text-warning opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Pending Out-Approval</div>
                        <h3 class="fw-bold my-1 text-info">@pendingOutCount</h3>
                        <span class="small text-muted">Awaiting HR Out-Punch check</span>
                    </div>
                    <i class="bi bi-box-arrow-right fs-1 text-info opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">WFH Requests</div>
                        <h3 class="fw-bold my-1 text-primary">@wfhCount</h3>
                        <span class="small text-muted">Remote punches on this date</span>
                    </div>
                    <i class="bi bi-house fs-1 text-primary opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Approved Records</div>
                        <h3 class="fw-bold my-1 text-success">@approvedCount</h3>
                        <span class="small text-muted">Verified on this date</span>
                    </div>
                    <i class="bi bi-check-circle fs-1 text-success opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters & Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-bottom py-3 px-3 px-md-4">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control bg-light border-start-0" placeholder="Search employee name, ID..." @bind="searchQuery" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <select class="form-select form-select-sm" @bind="selectedFilter">
                        <option value="ALL_PENDING">Pending Approvals (In or Out)</option>
                        <option value="IN_PENDING">Check-In Pending Only</option>
                        <option value="OUT_PENDING">Check-Out Pending Only</option>
                        <option value="WFH_ONLY">Remote / WFH Only</option>
                        <option value="APPROVED">Approved Records</option>
                        <option value="ALL">All Records</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <input type="date" class="form-control form-control-sm" value="@selectedDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
                </div>
                <div class="col-12 col-md-2 text-start text-md-end">
                    <span class="badge bg-secondary">Total: @filteredList.Count</span>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="min-width: 850px;">
                <thead class="table-light small text-uppercase text-nowrap">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Office Hub</th>
                        <th>Date & Timing</th>
                        <th>Type / GPS</th>
                        <th>In Status</th>
                        <th>Out Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <span class="spinner-border spinner-border-sm me-2"></span> Loading attendance queue...
                            </td>
                        </tr>
                    }
                    else if (filteredList.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-check-circle fs-2 text-success d-block mb-2"></i>
                                Nothing to show for this filter and date.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in filteredList)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                            @GetInitials(item.EmployeeName)
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.EmployeeName</div>
                                            <div class="text-muted small">ID: @item.EmployeeCode • @item.Designation</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-geo-alt me-1 text-primary"></i> @item.BranchName
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.Date</div>
                                    <div class="small text-muted">
                                        <span class="text-success"><i class="bi bi-box-arrow-in-right"></i> @(item.InTime ?? "--:--")</span> |
                                        <span class="text-danger"><i class="bi bi-box-arrow-right"></i> @(item.OutTime ?? "--:--")</span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.IsWfh)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle d-inline-flex align-items-center">
                                            <i class="bi bi-house-door-fill me-1"></i> WFH
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle d-inline-flex align-items-center">
                                            <i class="bi bi-building me-1"></i> On-Site
                                        </span>
                                    }
                                    <div class="small text-muted">@item.DistanceDesc</div>
                                </td>
                                <td><span class="badge @GetBadgeClass(item.InApprovalStatus)">In: @StatusText(item.InApprovalStatus)</span></td>
                                <td><span class="badge @GetBadgeClass(item.OutApprovalStatus)">Out: @StatusText(item.OutApprovalStatus)</span></td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        @if (IsPending(item.InApprovalStatus))
                                        {
                                            <button class="btn btn-outline-success" title="Approve In-Time" disabled="@isBusy" @onclick="() => ApprovePunch(item, true, true)">
                                                <i class="bi bi-box-arrow-in-right me-1"></i> In
                                            </button>
                                            <button class="btn btn-outline-danger" title="Reject In-Time" disabled="@isBusy" @onclick="() => ApprovePunch(item, true, false)">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        }

                                        @if (IsPending(item.OutApprovalStatus))
                                        {
                                            <button class="btn btn-outline-success" title="Approve Out-Time" disabled="@isBusy" @onclick="() => ApprovePunch(item, false, true)">
                                                <i class="bi bi-box-arrow-right me-1"></i> Out
                                            </button>
                                            <button class="btn btn-outline-danger" title="Reject Out-Time" disabled="@isBusy" @onclick="() => ApprovePunch(item, false, false)">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        }

                                        @if (IsPending(item.InApprovalStatus) && IsPending(item.OutApprovalStatus))
                                        {
                                            <button class="btn btn-success" title="Approve Both" disabled="@isBusy" @onclick="() => ApproveIds(new List<string> { item.AttendanceId })">
                                                <i class="bi bi-check2-all"></i> Both
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string searchQuery = "";
    private string selectedFilter = "ALL_PENDING";
    private DateTime selectedDate = DateTime.Today;

    private int pendingInCount, pendingOutCount, wfhCount, approvedCount;

    private string? statusMessage;
    private bool isSuccess = true;
    private bool isLoading = false;
    private bool isBusy = false;
    private string currentUser = "";

    private List<ApprovalRecord> queue = new();

    private static readonly JsonSerializerOptions JsonOpts = CreateOptions();

    private static JsonSerializerOptions CreateOptions()
    {
        var o = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        o.Converters.Add(new FlexibleBoolConverter());
        return o;
    }

    public class FlexibleBoolConverter : System.Text.Json.Serialization.JsonConverter<bool>
    {
        public override bool Read(ref Utf8JsonReader reader, Type typeToConvert, JsonSerializerOptions options)
        {
            switch (reader.TokenType)
            {
                case JsonTokenType.True: return true;
                case JsonTokenType.False: return false;
                case JsonTokenType.Number:
                    if (reader.TryGetInt64(out long l)) return l != 0;
                    return reader.TryGetDouble(out double d) && d != 0.0;
                case JsonTokenType.String:
                    var s = reader.GetString()?.Trim();
                    return s == "1" || string.Equals(s, "true", StringComparison.OrdinalIgnoreCase) || string.Equals(s, "yes", StringComparison.OrdinalIgnoreCase);
                default: return false;
            }
        }

        public override void Write(Utf8JsonWriter writer, bool value, JsonSerializerOptions options) => writer.WriteBooleanValue(value);
    }

    public class ApprovalRecord
    {
        [System.Text.Json.Serialization.JsonPropertyName("id")] public string AttendanceId { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("employee_name")] public string EmployeeName { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("employee_code")] public string EmployeeCode { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("designation")] public string? Designation { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("branch_name")] public string BranchName { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("date")] public string Date { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("in_time")] public string? InTime { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("out_time")] public string? OutTime { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("is_wfh")]
        [System.Text.Json.Serialization.JsonConverter(typeof(FlexibleBoolConverter))]
        public bool IsWfh { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("distance_desc")] public string DistanceDesc { get; set; } = "";
        [System.Text.Json.Serialization.JsonPropertyName("in_status")] public string InApprovalStatus { get; set; } = "NOT_PUNCHED";
        [System.Text.Json.Serialization.JsonPropertyName("out_status")] public string OutApprovalStatus { get; set; } = "NOT_PUNCHED";
    }

    private static bool IsPending(string? s) => string.Equals(s, "PENDING", StringComparison.OrdinalIgnoreCase);
    private static bool IsApproved(string? s) => string.Equals(s, "APPROVED", StringComparison.OrdinalIgnoreCase);

    private List<ApprovalRecord> filteredList => queue
        .Where(x => string.IsNullOrWhiteSpace(searchQuery) ||
                    x.EmployeeName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    x.EmployeeCode.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(x => selectedFilter switch
        {
            "IN_PENDING" => IsPending(x.InApprovalStatus),
            "OUT_PENDING" => IsPending(x.OutApprovalStatus),
            "WFH_ONLY" => x.IsWfh,
            "APPROVED" => IsApproved(x.InApprovalStatus) || IsApproved(x.OutApprovalStatus),
            "ALL_PENDING" => IsPending(x.InApprovalStatus) || IsPending(x.OutApprovalStatus),
            _ => true
        })
        .ToList();

    private bool HasPendingVisible => filteredList.Any(x => IsPending(x.InApprovalStatus) || IsPending(x.OutApprovalStatus));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User.Identity?.Name ?? "";
        await LoadAttendanceQueue();
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            selectedDate = d;
            await LoadAttendanceQueue();
        }
    }

    private async Task LoadAttendanceQueue()
    {
        isLoading = true;
        StateHasChanged();
        try
        {
            var req = new APIDataAccParms
            {
                ProcName = "sp_ticket_operations",
                ProcID = "GET_APPROVAL_QUEUE",
                parm01 = selectedDate.ToString("yyyy-MM-dd"),
                parm05 = currentUser
            };

            var res = await BackendApi.FetchDataAsync(req);
            queue = ParseList<ApprovalRecord>(res);
            RecalculateStats();
        }
        catch (Exception ex)
        {
            statusMessage = "Queue load error: " + ex.Message;
            isSuccess = false;
            queue = new();
            RecalculateStats();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RecalculateStats()
    {
        pendingInCount = queue.Count(x => IsPending(x.InApprovalStatus));
        pendingOutCount = queue.Count(x => IsPending(x.OutApprovalStatus));
        wfhCount = queue.Count(x => x.IsWfh);
        approvedCount = queue.Count(x => IsApproved(x.InApprovalStatus) || IsApproved(x.OutApprovalStatus));
    }

    private async Task ApprovePunch(ApprovalRecord item, bool isInPunch, bool isApprove)
    {
        string remarks = "";
        if (!isApprove)
        {
            // window.prompt returns null when the reviewer cancels
            var reason = await JS.InvokeAsync<string?>("prompt", $"Reason for rejecting {item.EmployeeName}'s {(isInPunch ? "check-in" : "check-out")} (optional):", "");
            if (reason == null) return;
            remarks = reason;
        }

        var newStatus = isApprove ? "APPROVED" : "REJECTED";
        var ok = await CallAction(isInPunch ? "APPROVE_IN" : "APPROVE_OUT", item.AttendanceId, newStatus, remarks);
        if (ok)
        {
            statusMessage = $"{item.EmployeeName}: {(isInPunch ? "check-in" : "check-out")} {newStatus.ToLower()}.";
            isSuccess = true;
            await LoadAttendanceQueue();
        }
    }

    private async Task ApproveIds(List<string> ids)
    {
        var ok = await CallAction("APPROVE_BULK", string.Join(",", ids), "", "");
        if (ok)
        {
            statusMessage = "Pending punches approved.";
            isSuccess = true;
            await LoadAttendanceQueue();
        }
    }

    private async Task BulkApprovePending()
    {
        var ids = filteredList
            .Where(x => IsPending(x.InApprovalStatus) || IsPending(x.OutApprovalStatus))
            .Select(x => x.AttendanceId)
            .ToList();
        if (ids.Count == 0) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Approve all pending punches for {ids.Count} record(s) currently shown?");
        if (!confirmed) return;

        await ApproveIds(ids);
    }

    // Sends one action and reports failure from the server's own "success"/"message" reply.
    private async Task<bool> CallAction(string procId, string p1, string p2, string p3)
    {
        isBusy = true;
        try
        {
            var req = new APIDataAccParms
            {
                ProcName = "sp_ticket_operations",
                ProcID = procId,
                parm01 = p1,
                parm02 = p2,
                parm03 = p3,
                parm05 = currentUser
            };

            var res = await BackendApi.FetchDataAsync(req);
            if (!CheckResult(res, out var message))
            {
                statusMessage = message;
                isSuccess = false;
                return false;
            }
            return true;
        }
        catch (Exception ex)
        {
            statusMessage = "Approval error: " + ex.Message;
            isSuccess = false;
            return false;
        }
        finally
        {
            isBusy = false;
        }
    }

    // Accepts a plain array/object, or the project's { result_json: "..." } wrapper.
    private static JsonElement? Unwrap(JsonElement? res)
    {
        if (!res.HasValue) return null;
        var el = res.Value;

        if (el.ValueKind == JsonValueKind.Array && el.GetArrayLength() > 0
            && el[0].ValueKind == JsonValueKind.Object && el[0].TryGetProperty("result_json", out var first))
            el = first;
        else if (el.ValueKind == JsonValueKind.Object && el.TryGetProperty("result_json", out var obj))
            el = obj;

        if (el.ValueKind == JsonValueKind.String)
        {
            var s = el.GetString();
            if (string.IsNullOrWhiteSpace(s)) return null;
            using var doc = JsonDocument.Parse(s);
            return doc.RootElement.Clone();
        }
        return el;
    }

    private static List<T> ParseList<T>(JsonElement? res)
    {
        var el = Unwrap(res);
        if (!el.HasValue || el.Value.ValueKind != JsonValueKind.Array) return new();
        return JsonSerializer.Deserialize<List<T>>(el.Value.GetRawText(), JsonOpts) ?? new();
    }

    private static bool CheckResult(JsonElement? res, out string message)
    {
        message = "";
        var el = Unwrap(res);
        if (!el.HasValue) return true;

        var v = el.Value;
        if (v.ValueKind == JsonValueKind.Array && v.GetArrayLength() > 0) v = v[0];
        if (v.ValueKind == JsonValueKind.Object
            && v.TryGetProperty("success", out var ok) && ok.ValueKind == JsonValueKind.False)
        {
            message = v.TryGetProperty("message", out var m) && m.ValueKind == JsonValueKind.String
                ? m.GetString() ?? "Request rejected."
                : "Request rejected.";
            return false;
        }
        return true;
    }

    private static string GetBadgeClass(string? status) => status?.ToUpperInvariant() switch
    {
        "APPROVED" => "bg-success",
        "REJECTED" => "bg-danger",
        "NOT_PUNCHED" => "bg-secondary",
        _ => "bg-warning text-dark"
    };

    private static string StatusText(string? status) => status?.ToUpperInvariant() == "NOT_PUNCHED" ? "—" : (status ?? "");

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
    }
}