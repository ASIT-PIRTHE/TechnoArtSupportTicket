                    var uPhone = GetPropString(user, "phone", "Phone");
                    var tBadges = GetUserTenantNames(user);
                    var pBadges = GetUserProjectNames(user);
                    var mBadges = GetUserModuleNames(user);

                    <div class="card border rounded-3 shadow-sm">
                        <div class="card-body p-3">
                            <!-- Card Header: Name, Role & Status -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">@uFullName</h6>
                                    @if (!string.IsNullOrEmpty(uDesig))
                                    {
                                        <div class="text-muted small"><i class="bi bi-briefcase me-1"></i>@uDesig</div>
                                    }
                                </div>
                                <span class="badge @(isAct ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle")">
                                    @(isAct ? "Active" : "Inactive")
                                </span>
                            </div>

                            <div class="mb-2">
                                <span class="badge @(uRole.StartsWith("Client") ? "bg-info text-dark" : "bg-primary") me-1">@uRole</span>
                                @if (!uRole.StartsWith("Client", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-clock me-1 text-primary"></i>@FormatShiftTiming(user)
                                    </span>
                                }
                            </div>

                            <!-- Contact / Identifier -->
                            <div class="small text-muted mb-2">
                                <div><i class="bi bi-person-circle me-1"></i><span class="font-monospace">@uName</span></div>
                                @if (!string.IsNullOrEmpty(uPhone))
                                {
                                    <div><i class="bi bi-telephone me-1"></i><span>@uPhone</span></div>
                                }
                            </div>

                            <!-- Tenants / Company -->
                            @if (tBadges.Any())
                            {
                                <div class="mb-2">
                                    <div class="small fw-semibold text-secondary mb-1"><i class="bi bi-building me-1"></i>Company:</div>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var tBadge in tBadges)
                                        {
                                            <span class="badge bg-light text-secondary border small">@tBadge</span>
