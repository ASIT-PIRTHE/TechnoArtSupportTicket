    private async Task CreateUser()
    {
        isSubmitting = true;
        userErrorMessage = "";
        StateHasChanged();
        
        if (!string.IsNullOrEmpty(newPassword) && newPassword != confirmPassword)
        {
            userErrorMessage = "Passwords do not match!";
            isSubmitting = false;
            StateHasChanged();
            return;
        }

        if (string.IsNullOrEmpty(editUserId) && string.IsNullOrEmpty(newPassword))
        {
            userErrorMessage = "Password is required for new users.";
            isSubmitting = false;
            StateHasChanged();
            return;
        }

        try
        {
            string finalTenantId = newTenantId;
            if (!IsInternalUser)
            {
                finalTenantId = !string.IsNullOrEmpty(CurrentUserTenantId) ? CurrentUserTenantId : newTenantId;
            }

            var isEdit = !string.IsNullOrEmpty(editUserId);

            if (string.IsNullOrEmpty(newProjectId) && selectedProjectIds.Count > 0)
            {
                newProjectId = selectedProjectIds.First();
            }
            if (string.IsNullOrEmpty(newModuleId) && selectedModuleIds.Count > 0)
            {
                newModuleId = selectedModuleIds.First();
            }

            bool isClient = IsClientUserRole(newRole);
            var hrData = new
            {
                phone = newPhone,
                national_id = isClient ? "" : newNationalId,
                father_name = isClient ? "" : newFatherName,
                mother_name = isClient ? "" : newMotherName,
                emergency_contact = isClient ? "" : newEmergencyContact,
                emergency_relation = isClient ? "" : newEmergencyRelation,
                department = isClient ? "Client Operations" : newDepartment,
                designation = isClient ? newRole : (string.IsNullOrEmpty(newDesignation) ? newRole : newDesignation),
                joining_date = isClient ? DateTime.Today.ToString("yyyy-MM-dd") : (newJoiningDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd")),
                branch_id = isClient ? "" : newBranchId,
                shift_in = isClient ? "09:30" : (newShiftInTime?.ToString("HH:mm") ?? "09:30"),
                shift_out = isClient ? "18:30" : (newShiftOutTime?.ToString("HH:mm") ?? "18:30"),
                blood_group = isClient ? "B+" : newBloodGroup,
                salary = isClient ? 0 : newMonthlySalary,
                projects = selectedProjectIds.ToList(),
                tenants = selectedTenantIds.ToList(),
                modules = selectedModuleIds.ToList()
            };

            var payload = new APIDataAccParms 
            { 
                ProcID = isEdit ? "UPDATE_USER" : "CREATE_USER",
                parm01 = isEdit ? editUserId : newUsername,
                parm02 = newFullName,
                parm03 = newRole,
                parm04 = finalTenantId,
                parm05 = newProjectId,
                parm06 = newModuleId,
                parm07 = string.IsNullOrEmpty(newPassword) ? "" : newPassword,
                parm08 = newPhone,
                parm09 = newNationalId,
                parm10 = newBloodGroup,
                parmJson1 = JsonSerializer.Serialize(hrData),
                ComCod = finalTenantId
            };

            var result = await BackendApi.FetchDataAsync(payload);
            string createdOrUpdatedUserId = isEdit ? editUserId! : "";
            
            if (result.HasValue)
            {
                var resEl = result.Value;
                if (resEl.ValueKind == JsonValueKind.Array && resEl.GetArrayLength() > 0) resEl = resEl[0];

                if (resEl.ValueKind == JsonValueKind.Object)
                {
                    if (resEl.TryGetProperty("error", out var err) && !string.IsNullOrEmpty(err.GetString()))
                    {
                        userErrorMessage = err.GetString()!;
                        isSubmitting = false;
                        StateHasChanged();
                        return;
                    }
                    if (resEl.TryGetProperty("errormessage", out var em) && !string.IsNullOrEmpty(em.GetString()))
                    {
                        userErrorMessage = em.GetString()!;
                        isSubmitting = false;
                        StateHasChanged();
                        return;
                    }
                    if (resEl.TryGetProperty("user_id", out var uid) && !string.IsNullOrEmpty(uid.GetString()))
                    {
                        createdOrUpdatedUserId = uid.GetString()!;
                    }
                }
            }

            if (string.IsNullOrEmpty(createdOrUpdatedUserId))
            {
                createdOrUpdatedUserId = isEdit ? editUserId! : newUsername;
            }

            // Sync Multi-Project Assignment
            foreach (var pId in selectedProjectIds)
            {
                try
                {
                    var assignReq = new APIDataAccParms
                    {
                        ProcID = "ASSIGN_TEAM_MEMBER",
                        parm01 = pId,
                        parm02 = createdOrUpdatedUserId,
                        parm03 = newRole
                    };
                    await BackendApi.FetchDataAsync(assignReq);
                }
                catch { }
            }

            // Sync Multi-Module Assignment
            foreach (var mId in selectedModuleIds)
            {
                try
                {
                    var assignModReq = new APIDataAccParms
                    {
                        ProcID = "ASSIGN_USER_MODULE",
                        parm01 = createdOrUpdatedUserId,
                        parm02 = mId,
                        parm03 = newProjectId
                    };
                    await BackendApi.FetchDataAsync(assignModReq);
                }
                catch { }
            }

            // Optimistic in-memory update so the UI immediately reflects changes without waiting
            try
            {
                var targetTenantName = tenantList.FirstOrDefault(t => GetPropString(t, "tenant_id", "id") == finalTenantId) is JsonElement matchedTenant
                    ? GetPropString(matchedTenant, "name", "tenant_name")
                    : (string.IsNullOrEmpty(finalTenantId) ? "Internal" : finalTenantId);

                var targetProjectName = projectList.FirstOrDefault(p => GetPropString(p, "project_id", "id") == newProjectId) is JsonElement matchedProj
                    ? GetPropString(matchedProj, "name", "project_name")
                    : "—";

                var targetModuleName = projectModules.FirstOrDefault(m => GetPropString(m, "module_id", "id") == newModuleId) is JsonElement matchedMod
                    ? GetPropString(matchedMod, "name", "module_name")
                    : "";

                var optimisticUserObj = new Dictionary<string, object?>
                {
                    ["user_id"] = createdOrUpdatedUserId,
                    ["id"] = createdOrUpdatedUserId,
                    ["full_name"] = newFullName,
                    ["name"] = newFullName,
                    ["username"] = newUsername,
                    ["role"] = newRole,
                    ["tenant_id"] = finalTenantId,
                    ["tenant_name"] = targetTenantName,
                    ["project_id"] = newProjectId,
                    ["project_name"] = targetProjectName,
                    ["module_id"] = newModuleId,
                    ["module_name"] = targetModuleName,
                    ["shift_in"] = newShiftInTime?.ToString("HH:mm") ?? "09:30",
                    ["shift_out"] = newShiftOutTime?.ToString("HH:mm") ?? "18:30",
                    ["shift_timing"] = $"{newShiftInTime?.ToString("hh:mm tt") ?? "09:30 AM"} - {newShiftOutTime?.ToString("hh:mm tt") ?? "06:30 PM"}",
                    ["is_active"] = true,
                    ["phone"] = newPhone,
                    ["national_id"] = newNationalId,
                    ["designation"] = string.IsNullOrEmpty(newDesignation) ? newRole : newDesignation,
                    ["department"] = newDepartment,
                    ["blood_group"] = newBloodGroup,
                    ["gross_salary"] = newMonthlySalary,
                    ["projects"] = selectedProjectIds.ToList(),
                    ["tenants"] = selectedTenantIds.ToList(),
                    ["modules"] = selectedModuleIds.ToList()
                };

                var optimisticJson = JsonSerializer.Serialize(optimisticUserObj);
                using var optimisticDoc = JsonDocument.Parse(optimisticJson);
                var optimisticEl = optimisticDoc.RootElement.Clone();

                var existingIndex = userList.FindIndex(u => {
                    var uid = GetPropString(u, "user_id", "id", "UserId", "Id");
                    var unm = GetPropString(u, "username", "userName", "UserName", "email", "Email");
                    return (!string.IsNullOrEmpty(uid) && uid == createdOrUpdatedUserId) ||
                           (!string.IsNullOrEmpty(unm) && string.Equals(unm, newUsername, StringComparison.OrdinalIgnoreCase));
                });

                if (existingIndex >= 0) userList[existingIndex] = optimisticEl;
                else userList.Insert(0, optimisticEl);
            }
            catch { }
            
            // Reset form state
            isAddMode = false;
            newFullName = "";
            newUsername = "";
            newPassword = "";
            confirmPassword = "";
            showPassword = false;
            showConfirmPassword = false;
            newRole = "";
            newTenantId = "";
            newProjectId = "";
            newModuleId = "";
            selectedProjectIds.Clear();
            selectedTenantIds.Clear();
            selectedModuleIds.Clear();
            editUserId = null;
            isSubmitting = false;
            StateHasChanged();

            await LoadUsers();
        }
        catch (Exception ex)
        {
            userErrorMessage = "Error saving user: " + ex.Message;
            isSubmitting = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    // -------------------------------------------------------------
    // USER ACTIVE STATUS TOGGLE
    // -------------------------------------------------------------
    private async Task ToggleUserActiveStatus(JsonElement user)
    {
        var uId = GetPropString(user, "user_id", "id", "UserId", "Id");
        var curActive = GetPropBool(user, true, "is_active", "IsActive");
        bool newActive = !curActive;

        try
        {
            var payload = new APIDataAccParms
            {
                ProcID = "UPDATE_USER_STATUS",
                parm01 = uId,
                parm02 = newActive ? "1" : "0"
            };
            await BackendApi.FetchDataAsync(payload);
            await LoadUsers();
        }
        catch (Exception ex)
        {
            userErrorMessage = "Error updating user status: " + ex.Message;
        }
    }

    // -------------------------------------------------------------
    // MULTI-BADGE DISPLAY HELPERS
    // -------------------------------------------------------------
    private List<string> GetUserProjectNames(JsonElement user)
    {
        var names = new List<string>();
        var pName = GetPropString(user, "project_name", "ProjectName");
        if (!string.IsNullOrEmpty(pName) && pName != "—") names.Add(pName);

        if (user.ValueKind == JsonValueKind.Object && user.TryGetProperty("projects", out var projsEl) && projsEl.ValueKind == JsonValueKind.Array)
        {
            foreach (var p in projsEl.EnumerateArray())
            {
                var pid = p.ValueKind == JsonValueKind.String ? p.GetString() : GetPropString(p, "project_id", "id");
                var pNameFromObj = p.ValueKind == JsonValueKind.Object ? GetPropString(p, "name", "project_name") : "";
                if (!string.IsNullOrEmpty(pNameFromObj))
                {
                    if (!names.Contains(pNameFromObj)) names.Add(pNameFromObj);
                }
                else if (!string.IsNullOrEmpty(pid))
                {
                    var matched = projectList.FirstOrDefault(proj => GetPropString(proj, "project_id", "id") == pid);
                    var matchedNm = GetPropString(matched, "name", "project_name");
                    if (!string.IsNullOrEmpty(matchedNm) && !names.Contains(matchedNm)) names.Add(matchedNm);
                }
            }
        }
        return names;
    }

