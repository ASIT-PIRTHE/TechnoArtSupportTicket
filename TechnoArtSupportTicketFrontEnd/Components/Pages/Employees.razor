                            <i class="bi bi-people fs-1 text-secondary opacity-50 d-block mb-2"></i>
                            <div>No users registered matching your criteria.</div>
                            @if (!string.IsNullOrEmpty(searchQuery) || !string.IsNullOrEmpty(selectedFilterTenant) || !string.IsNullOrEmpty(selectedFilterProject) || !string.IsNullOrEmpty(selectedFilterRole))
                            {
                                <button class="btn btn-outline-secondary btn-sm mt-2" @onclick="ResetFilters">Reset Filters</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <!-- Table Bottom Status & Scroll Helper Bar -->
        <div class="d-flex justify-content-between align-items-center py-2 px-3 bg-light border-top small text-muted">
            <div>
                <i class="bi bi-people me-1 text-primary"></i> Total: <strong>@(DisplayedUserList?.Count() ?? 0)</strong> users / employees
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">
                    <i class="bi bi-arrow-left-right me-1"></i> Scroll horizontally to view all columns
                </span>
            </div>
        </div>
    </div>

    <!-- Mobile Card View: Clean Stacked Cards for Smartphone Viewports (< 768px) -->
    <div class="d-md-none">
        @if (isLoading)
        {
            <div class="card border-0 p-4 text-center">
                <div class="spinner-border text-primary mx-auto" role="status"></div>
                <div class="text-muted small mt-2">Loading user directory...</div>
            </div>
        }
        else if (DisplayedUserList != null && DisplayedUserList.Any())
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var user in DisplayedUserList)
