    private async Task LoadDynamicRoles()
    {
        try
        {
            var req = new APIDataAccParms { ProcName = "sp_permission_operations", ProcID = "GET_ROLES" };
            var res = await BackendApi.FetchDataAsync(req);
            if (res.HasValue)
            {
                var fetched = new List<RoleOption>();
                ExtractItems(res.Value, el =>
                {
                    if (el.ValueKind == JsonValueKind.Object)
                    {
                        var key = GetPropString(el, "Key", "key_name", "RoleKey", "key", "role");
                        var name = GetPropString(el, "DisplayName", "display_name", "DisplayName", "Name", "name");
                        if (string.IsNullOrEmpty(name)) name = key;
                        if (!string.IsNullOrEmpty(key) && !fetched.Any(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase)))
                        {
                            fetched.Add(new RoleOption { Key = key, DisplayName = name });
                        }
                    }
                });

                if (fetched.Count > 0)
                {
                    availableRoles = fetched;
                }
            }
        }
        catch {}
    }

