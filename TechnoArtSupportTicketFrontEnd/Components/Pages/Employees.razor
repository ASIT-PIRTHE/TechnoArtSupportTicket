                        <th style="min-width: 160px;">Identifier</th>
                        <th style="min-width: 150px;">Shift Timing</th>
                        <th style="min-width: 140px;">Tenant / Company</th>
                        <th style="min-width: 160px;">Assigned Projects</th>
                        <th style="min-width: 160px;">Assigned Modules</th>
                        <th style="min-width: 90px;">Status</th>
                        <th style="min-width: 140px;" class="text-end sticky-action-col">Actions</th>
                    </tr>
                </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr>
                        <td colspan="8" class="text-center p-5">
