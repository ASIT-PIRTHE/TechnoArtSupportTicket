                                {
                                    <div class="small text-secondary"><i class="bi bi-telephone me-1"></i>@uPhone</div>
                                }
                            </td>
                            <td>
                                @if (uRole.StartsWith("Client", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="text-muted small fst-italic">N/A (Client)</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-clock me-1 text-primary"></i>@shiftTimingDisplay
                                    </span>
                                }
                            </td>
