                        var uId = GetPropString(user, "user_id", "id", "UserId", "Id");
                        var uFullName = GetPropString(user, "full_name", "name", "FullName", "Name");
                        var uName = GetPropString(user, "username", "userName", "UserName", "email", "Email");
                        var uRole = GetPropString(user, "role", "Role");
                        var uDesig = GetPropString(user, "designation", "Designation");
                        var shiftTimingDisplay = FormatShiftTiming(user);
                        var isAct = GetPropBool(user, true, "is_active", "IsActive");
                        var userSalary = GetPropDecimal(user, 0, "gross_salary", "GrossSalary", "salary");

                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@uFullName</div>
