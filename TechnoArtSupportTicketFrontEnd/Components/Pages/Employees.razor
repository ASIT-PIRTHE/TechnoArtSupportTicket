    private async Task ToggleProjectSelection(string projId, object? checkedVal)
    {
        bool isChecked = checkedVal is bool b && b;
        if (isChecked)
        {
            selectedProjectIds.Add(projId);
            if (string.IsNullOrEmpty(newProjectId)) newProjectId = projId;
        }
        else
        {
            selectedProjectIds.Remove(projId);
            if (newProjectId == projId) newProjectId = selectedProjectIds.FirstOrDefault() ?? "";
        }
        await RefreshAvailableModules();
        StateHasChanged();
    }

