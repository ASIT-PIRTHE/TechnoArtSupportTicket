                            </td>
                            <!-- Multi-Project Badges -->
                            <td>
                                @{
                                    var pBadges = GetUserProjectNames(user);
                                }
                                @if (pBadges.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var pBadge in pBadges)
