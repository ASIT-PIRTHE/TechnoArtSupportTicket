                                <span class="badge @(uRole.StartsWith("Client") ? "bg-info text-dark" : "bg-primary") mt-1">@uRole</span>
                            </td>
                            <td>
                                <span class="small font-monospace text-muted">@uName</span>
                                @{
                                    var uPhone = GetPropString(user, "phone", "Phone");
                                }
