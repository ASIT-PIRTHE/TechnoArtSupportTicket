@page "/admin/employees"
@using Microsoft.AspNetCore.Components.Authorization
@using TechnoArtSupportTicketFrontEnd.Services
@using System.Security.Claims
@using System.Text.Json
@attribute [Authorize(Roles = "SuperAdmin,MD,ClientAdmin,ProjectManager,HRManager,SupportManager,Admin,AccountsOfficer")]
@inject ApiService BackendApi
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Config

<PageTitle>User & Employee Management - TechnoArt</PageTitle>

<div class="custom-card p-3 p-md-4 h-100" style="max-width: 100%; overflow-x: hidden;">
    <!-- Header Section with Dynamic Context Scope -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 border-bottom pb-3 gap-3">
        <div>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <h5 class="fw-bold m-0"><i class="bi bi-people text-primary me-2"></i> User & Employee Directory</h5>
                @if (IsClientAdmin || !IsInternalUser)
                {
                    <span class="badge bg-info-subtle text-dark border border-info-subtle">
                        <i class="bi bi-building me-1"></i>@(string.IsNullOrEmpty(CurrentTenantName) ? "Client Tenant" : CurrentTenantName)
                    </span>
                }
                else
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                        <i class="bi bi-globe me-1"></i>Enterprise Global Scope
                    </span>
                }
            </div>
            <small class="text-muted d-block mt-1">Manage internal engineering staff, multi-project rosters, multi-tenant operators, and client users with button-level permissions.</small>
        </div>
        
        <!-- Button-Level Permission: Add New User / Employee -->
        @if (CanCreateUser)
        {
            <div>
                <button class="btn btn-primary btn-sm rounded-pill px-3 py-2 fw-semibold shadow-sm text-nowrap d-inline-flex align-items-center" @onclick="ToggleAddMode">
                    <i class="bi @(isAddMode ? "bi-x-lg" : "bi-plus-lg") me-1"></i> @(isAddMode ? "Cancel" : "Add New User / Employee")
                </button>
            </div>
        }
    </div>

    <!-- Tenant Context Banner for Client Scope -->
    @if (!IsInternalUser && !string.IsNullOrEmpty(CurrentUserTenantId))
    {
        <div class="alert alert-info py-2 small d-flex align-items-center mb-3">
            <i class="bi bi-info-circle-fill fs-5 me-2 text-info"></i>
            <div>
                <strong>Tenant Organization Scope:</strong> You have access to users, projects, and modules for <strong>@(string.IsNullOrEmpty(CurrentTenantName) ? "Your Company" : CurrentTenantName)</strong>. Internal engineering credentials and salary records are securely protected.
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(userErrorMessage) && !isAddMode)
    {
        <div class="alert alert-danger py-2 small d-flex align-items-center mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@userErrorMessage</div>
        </div>
    }

    <!-- Add / Edit User Form Card -->
    @if (isAddMode && CanCreateUser)
    {
        <div class="card bg-light border-primary mb-4 shadow-sm border-0 border-start border-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold m-0 text-primary">
                        <i class="bi @(string.IsNullOrEmpty(editUserId) ? "bi-person-plus" : "bi-pencil-square") me-1"></i>
                        @(string.IsNullOrEmpty(editUserId) ? "Register New User / Employee" : "Edit User / Employee Profile")
                    </h6>
                    <button type="button" class="btn-close" @onclick="ToggleAddMode"></button>
                </div>

                @if (!string.IsNullOrEmpty(userErrorMessage))
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@userErrorMessage
                    </div>
                }

                <form @onsubmit="CreateUser" @onsubmit:preventDefault="true">
                    <!-- Basic Information Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="newFullName" required placeholder="e.g. John Doe" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold">
                                Identifier (Username / Email)
                                @if (!string.IsNullOrEmpty(editUserId))
                                {
                                    <span class="text-muted">(Read-only)</span>
                                }
                                else
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>
                            <input type="text" class="form-control" @bind="newUsername" required="@(string.IsNullOrEmpty(editUserId))" disabled="@(!string.IsNullOrEmpty(editUserId))" placeholder="e.g. jdoe123 or shuvo@tas.com" />
                        </div>
                    </div>

                    <!-- Credentials & Dynamic Role Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label class="form-label small fw-semibold">
                                Password
                                @if (!string.IsNullOrEmpty(editUserId))
                                {
                                    <span class="text-muted">(Optional)</span>
                                }
                                else
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>
                            <div class="input-group">
                                <input type="@(showPassword ? "text" : "password")" class="form-control" @bind="newPassword" required="@(string.IsNullOrEmpty(editUserId))" placeholder="@(string.IsNullOrEmpty(editUserId) ? "Password" : "Unchanged")" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => showPassword = !showPassword" tabindex="-1">
                                    <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label class="form-label small fw-semibold">
                                Confirm Password
                                @if (string.IsNullOrEmpty(editUserId))
                                {
                                    <span class="text-danger">*</span>
                                }
                                else
                                {
                                    <span class="text-muted">(If changing)</span>
                                }
                            </label>
                            <div class="input-group">
                                <input type="@(showConfirmPassword ? "text" : "password")" class="form-control" @bind="confirmPassword" required="@(string.IsNullOrEmpty(editUserId) || !string.IsNullOrEmpty(newPassword))" placeholder="Confirm Password" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => showConfirmPassword = !showConfirmPassword" tabindex="-1">
                                    <i class="bi @(showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label class="form-label small fw-semibold">Dynamic Role <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="newRole" required>
                                <option value="">-- Select Dynamic Role --</option>
                                @foreach (var r in FilteredAvailableRoles)
                                {
                                    <option value="@r.Key">@r.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label class="form-label small fw-semibold">Primary Tenant / Company</label>
                            <select class="form-select" value="@newTenantId" @onchange="OnTenantChanged" disabled="@(!IsInternalUser)">
                                @if (IsInternalUser)
                                {
                                    <option value="">-- Internal / Global TAS --</option>
                                }
                                @foreach (var tenant in AccessibleTenants)
                                {
                                    var tId = GetPropString(tenant, "tenant_id", "id");
                                    var tNm = GetPropString(tenant, "name", "tenant_name");
                                    <option value="@tId">@tNm</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (IsClientUserRole(newRole))
                    {
                        <!-- Compact Contact Info for Client Roles -->
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold"><i class="bi bi-telephone me-1 text-primary"></i> Contact Phone Number</label>
                                <input type="text" class="form-control" @bind="newPhone" placeholder="017xxxxxxxx" />
                            </div>
                        </div>
                    }

                    <!-- Multi-Tenant Selection (For Internal Staff with Multiple Company Access) -->
                    @if (IsInternalUser && tenantList.Count > 1 && !IsClientUserRole(newRole))
                    {
                        <div class="card bg-white border rounded-3 p-3 mb-3 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label small fw-bold text-secondary mb-0">
                                    <i class="bi bi-building-check me-1"></i> Multi-Tenant Access (Employee can access multiple companies)
                                </label>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">@selectedTenantIds.Count company/companies selected</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var t in tenantList)
                                {
                                    var tId = GetPropString(t, "tenant_id", "id");
                                    var tNm = GetPropString(t, "name", "tenant_name");
                                    if (!string.IsNullOrEmpty(tId))
                                    {
                                        var isChecked = selectedTenantIds.Contains(tId);
                                        <div class="form-check form-check-inline bg-light px-3 py-2 rounded-2 border">
                                            <input class="form-check-input" type="checkbox" id="tenant_@tId" checked="@isChecked" @onchange="(e) => ToggleTenantSelection(tId, e.Value)" />
                                            <label class="form-check-label small fw-semibold cursor-pointer" for="tenant_@tId">@tNm</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }

                    <!-- Multi-Project Assignment Section -->
                    <div class="card bg-white border rounded-3 p-3 mb-3 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small fw-bold text-primary mb-0">
                                <i class="bi bi-kanban me-1"></i> Multi-Project Assignment (Employee can work on multiple projects simultaneously)
                            </label>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@selectedProjectIds.Count project(s) assigned</span>
                        </div>
                        <p class="text-muted small mb-2">Select all projects this user/engineer is assigned to:</p>
                        @if (FilteredProjects.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var proj in FilteredProjects)
                                {
                                    var pId = GetPropString(proj, "project_id", "id");
                                    var pNm = GetPropString(proj, "name", "project_name");
                                    var pCd = GetPropString(proj, "code");
                                    if (!string.IsNullOrEmpty(pId))
                                    {
                                        var isChecked = selectedProjectIds.Contains(pId);
                                        <div class="form-check form-check-inline bg-light px-3 py-2 rounded-2 border shadow-sm">
                                            <input class="form-check-input" type="checkbox" id="proj_@pId" checked="@isChecked" @onchange="(e) => ToggleProjectSelection(pId, e.Value)" />
                                            <label class="form-check-label small fw-semibold cursor-pointer" for="proj_@pId">
                                                @pNm @(!string.IsNullOrEmpty(pCd) ? $"({pCd})" : "")
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small">No projects registered for this tenant yet.</div>
                        }
                    </div>

                    <!-- Multi-Module Assignment Section (Modules across Selected Projects) -->
                    <div class="card bg-white border rounded-3 p-3 mb-3 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small fw-bold text-info mb-0">
                                <i class="bi bi-diagram-3 me-1"></i> Multi-Module Assignment (e.g. HRM, Payroll, Inventory, CPF)
                            </label>
                            <span class="badge bg-info-subtle text-dark border border-info-subtle">@selectedModuleIds.Count module(s) assigned</span>
                        </div>
                        <p class="text-muted small mb-2">Select all software modules this team member has operational permissions for:</p>
                        @if (projectModules.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var mod in projectModules)
                                {
                                    var mId = GetPropString(mod, "module_id", "id");
                                    var mNm = GetPropString(mod, "name", "module_name");
                                    var mCd = GetPropString(mod, "code");
                                    if (!string.IsNullOrEmpty(mId))
                                    {
                                        var isChecked = selectedModuleIds.Contains(mId);
                                        <div class="form-check form-check-inline bg-light px-3 py-2 rounded-2 border shadow-sm">
                                            <input class="form-check-input" type="checkbox" id="mod_@mId" checked="@isChecked" @onchange="(e) => ToggleModuleSelection(mId, e.Value)" />
                                            <label class="form-check-label small fw-semibold cursor-pointer" for="mod_@mId">
                                                @mNm @(!string.IsNullOrEmpty(mCd) ? $"({mCd})" : "")
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small fst-italic">Select projects above to load and check available modules.</div>
                        }
                    </div>

                    @if (!IsClientUserRole(newRole))
                    {
                        <!-- HR Profile & Family Identity (Internal Staff Only) -->
                        <div class="border-top pt-3 mt-3">
                            <div class="fw-bold text-primary mb-2 small text-uppercase tracking-wider">
                                <i class="bi bi-person-vcard me-1"></i> Official Identity & HR Details
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label class="form-label small fw-semibold">Phone Number</label>
                                    <input type="text" class="form-control" @bind="newPhone" placeholder="017xxxxxxxx" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label class="form-label small fw-semibold">National ID (NID No.)</label>
                                    <input type="text" class="form-control" @bind="newNationalId" placeholder="e.g. 1990xxxxxxxxxx" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label class="form-label small fw-semibold">Father's Name</label>
                                    <input type="text" class="form-control" @bind="newFatherName" placeholder="Father's full name" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label class="form-label small fw-semibold">Mother's Name</label>
                                    <input type="text" class="form-control" @bind="newMotherName" placeholder="Mother's full name" />
                                </div>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label class="form-label small fw-semibold">Emergency Contact</label>
                                    <input type="text" class="form-control" @bind="newEmergencyContact" placeholder="018xxxxxxxx" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label class="form-label small fw-semibold">Emergency Relation</label>
                                    <input type="text" class="form-control" @bind="newEmergencyRelation" placeholder="e.g. Brother, Spouse" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label class="form-label small fw-semibold">Office Branch / Hub</label>
                                    <select class="form-select" @bind="newBranchId">
                                        <option value="">-- Main Hub / Default --</option>
                                        @foreach (var b in branchList)
                                        {
                                            var bid = GetPropString(b, "id", "branch_id");
                                            var bnm = GetPropString(b, "name", "branch_name");
                                            <option value="@bid">@bnm</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label class="form-label small fw-semibold">Joining Date</label>
                                    <input type="date" class="form-control" @bind="newJoiningDate" />
                                </div>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-semibold text-primary"><i class="bi bi-briefcase me-1"></i> Official Designation</label>
                                    <input type="text" list="designationOptions" class="form-control" @bind="newDesignation" placeholder="Select or type designation..." />
                                    <datalist id="designationOptions">
                                        @foreach (var desig in designationList)
                                        {
                                            <option value="@desig">@desig</option>
                                        }
                                    </datalist>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label small fw-semibold text-primary"><i class="bi bi-building-gear me-1"></i> Department</label>
                                    <input type="text" class="form-control" @bind="newDepartment" placeholder="e.g. Engineering, Quality Assurance, HR, Accounts" />
                                </div>
                            </div>
                        </div>

                        <!-- Attendance, Shifts & Payroll Configuration (Internal Staff Only) -->
                        <div class="border-top pt-3 mt-3">
                            <div class="fw-bold text-primary mb-2 small text-uppercase tracking-wider">
                                <i class="bi bi-clock-history me-1"></i> Shift Timing & Roster
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label class="form-label small fw-semibold">Shift In-Time</label>
                                    <input type="time" class="form-control" @bind="newShiftInTime" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label class="form-label small fw-semibold">Shift Out-Time</label>
                                    <input type="time" class="form-control" @bind="newShiftOutTime" />
                                </div>
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label class="form-label small fw-semibold"><i class="bi bi-droplet text-danger me-1"></i> Blood Group</label>
                                    <select class="form-select" @bind="newBloodGroup">
                                        <option value="A+">A+</option>
                                        <option value="A-">A-</option>
                                        <option value="B+">B+</option>
                                        <option value="B-">B-</option>
                                        <option value="O+">O+</option>
                                        <option value="O-">O-</option>
                                        <option value="AB+">AB+</option>
                                        <option value="AB-">AB-</option>
                                    </select>
                                </div>

                                <!-- Button-Level Permission: Salary Field Visible ONLY to HR / SuperAdmin / MD -->
                                @if (CanViewSalary)
                                {
                                    <div class="col-12 col-sm-6 col-lg-3">
                                        <label class="form-label small fw-semibold"><i class="bi bi-cash text-success me-1"></i> Gross Salary (BDT)</label>
                                        <input type="number" class="form-control" @bind="newMonthlySalary" placeholder="e.g. 0.00" onwheel="this.blur()" />
                                    </div>
                                }
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12">
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" id="wfhAllowedSwitch" @bind="newIsWfhAllowed">
                                        <label class="form-check-label small fw-semibold" for="wfhAllowedSwitch">
                                            <i class="bi bi-laptop me-1 text-primary"></i> Allow Work From Home (WFH) Attendance Geofence Bypass
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-light border" @onclick="ToggleAddMode">Cancel</button>
                        <button type="submit" class="btn btn-success fw-semibold shadow-sm" disabled="@isSubmitting">
                            @if (isSubmitting) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            <i class="bi bi-check2-circle me-1"></i>
                            @(string.IsNullOrEmpty(editUserId) ? "Save User & Employee" : "Update Profile")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Search & Filter Controls Bar -->
    <div class="card border-0 bg-light p-3 rounded-3 mb-3 shadow-sm">
        <div class="row g-2 align-items-center">
            <!-- Search Input -->
            <div class="col-12 col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Search by name, email, username, phone..." @bind="searchQuery" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => searchQuery = string.Empty"><i class="bi bi-x"></i></button>
                    }
                </div>
            </div>

            <!-- Tenant Filter (If user has multiple tenant access or internal) -->
            @if (IsInternalUser && tenantList.Count > 1)
            {
                <div class="col-12 col-sm-6 col-md-3">
                    <select class="form-select form-select-sm" @bind="selectedFilterTenant">
                        <option value="">🏢 All Companies / Tenants</option>
                        <option value="INTERNAL">TAS Internal Staff</option>
                        @foreach (var t in tenantList)
                        {
                            var tid = GetPropString(t, "tenant_id", "id");
                            var tnm = GetPropString(t, "name", "tenant_name");
                            <option value="@tid">@tnm</option>
                        }
                    </select>
                </div>
            }

            <!-- Project Filter -->
            <div class="col-12 col-sm-6 @(IsInternalUser && tenantList.Count > 1 ? "col-md-3" : "col-md-4")">
                <select class="form-select form-select-sm" @bind="selectedFilterProject">
                    <option value="">📂 All Projects</option>
                    @foreach (var p in FilteredProjects)
                    {
                        var pid = GetPropString(p, "project_id", "id");
                        var pnm = GetPropString(p, "name", "project_name");
                        <option value="@pid">@pnm</option>
                    }
                </select>
            </div>

            <!-- Role Filter -->
            <div class="col-12 col-sm-6 @(IsInternalUser && tenantList.Count > 1 ? "col-md-2" : "col-md-4")">
                <select class="form-select form-select-sm" @bind="selectedFilterRole">
                    <option value="">👥 All Roles</option>
                    @foreach (var r in FilteredAvailableRoles)
                    {
                        <option value="@r.Key">@r.DisplayName</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <style>
        /* Always-visible clean scrollbar at bottom of table container */
        .employee-table-container {
            overflow-x: auto !important;
            overflow-y: auto !important;
            max-height: calc(100vh - 280px);
            min-height: 380px;
            position: relative;
            background: #ffffff;
        }
        
        /* Modern, prominent, easy-to-use scrollbar at bottom of table */
        .employee-table-container::-webkit-scrollbar {
            height: 12px;
            width: 8px;
        }
        .employee-table-container::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 6px;
        }
        .employee-table-container::-webkit-scrollbar-thumb {
            background: #0d6efd;
            border-radius: 6px;
            border: 2px solid #f1f5f9;
        }
        .employee-table-container::-webkit-scrollbar-thumb:hover {
            background: #0b5ed7;
        }
        
        /* Firefox scrollbar */
        .employee-table-container {
            scrollbar-width: auto;
            scrollbar-color: #0d6efd #f1f5f9;
        }

        /* Sticky table header when scrolling vertically */
        .employee-table-container thead th {
            position: sticky;
            top: 0;
            background-color: #f8f9fa !important;
            z-index: 10;
            box-shadow: inset 0 -1px 0 #dee2e6;
        }

        /* Sticky actions column pinned to the right edge */
        .sticky-action-col {
            position: sticky;
            right: 0;
            background-color: #ffffff;
            z-index: 8;
            box-shadow: -3px 0 6px rgba(0, 0, 0, 0.06);
        }
        thead th.sticky-action-col {
            background-color: #f8f9fa !important;
            z-index: 12;
        }
        tr:hover td.sticky-action-col {
            background-color: #f8f9fa !important;
        }
    </style>

    <!-- Desktop & Tablet View: Full Width Responsive Table with Visible Bottom Scrollbar -->
    <div class="shadow-sm rounded-3 border d-none d-md-block bg-white overflow-hidden mb-3">
        <div class="employee-table-container">
