    private async Task LoadUsers()
    {
        isLoading = true;
        userErrorMessage = "";
        StateHasChanged();
        try
        {
            await ResolveUserAuthContext();
            string targetComCod = IsInternalUser ? "" : CurrentUserTenantId;
            string targetRole = !string.IsNullOrEmpty(CurrentUserRole) ? CurrentUserRole : "SuperAdmin";

            var payload = new APIDataAccParms { 
                ProcName = "sp_ticket_operations",
                ProcID = "GET_USERS", 
                ComCod = targetComCod, 
                parm04 = CurrentUserId,
                parm05 = targetRole 
            };
            var result = await BackendApi.FetchDataAsync(payload);
            
            if (result.HasValue && result.Value.ValueKind == JsonValueKind.Object && result.Value.TryGetProperty("error", out var errEl) && !string.IsNullOrEmpty(errEl.GetString()))
            {
                userErrorMessage = errEl.GetString()!;
            }

            var tempList = new List<JsonElement>();
            if (result.HasValue)
            {
                ExtractItems(result.Value, el =>
                {
                    var uid = GetPropString(el, "user_id", "id", "UserId", "Id");
                    var unm = GetPropString(el, "username", "userName", "UserName", "email", "Email");
                    if (!string.IsNullOrEmpty(uid) || !string.IsNullOrEmpty(unm))
                    {
                        if (!tempList.Any(x => GetPropString(x, "user_id", "id", "UserId", "Id") == uid && !string.IsNullOrEmpty(uid)))
                        {
                            tempList.Add(el);
                        }
                    }
                });
            }

            // Resilient Fallback 1: Try GET_TEAM_MEMBERS with global ComCod if GET_USERS returned 0
            if (tempList.Count == 0)
            {
                var fbPayload = new APIDataAccParms
                {
                    ProcName = "sp_ticket_operations",
                    ProcID = "GET_TEAM_MEMBERS",
                    ComCod = "",
                    parm04 = CurrentUserId,
                    parm05 = "SuperAdmin"
                };
                var fbResult = await BackendApi.FetchDataAsync(fbPayload);
                if (fbResult.HasValue)
                {
                    ExtractItems(fbResult.Value, el =>
                    {
                        var uid = GetPropString(el, "user_id", "id", "UserId", "Id");
                        var unm = GetPropString(el, "username", "userName", "UserName", "email", "Email");
                        if (!string.IsNullOrEmpty(uid) || !string.IsNullOrEmpty(unm))
                        {
                            if (!tempList.Any(x => GetPropString(x, "user_id", "id", "UserId", "Id") == uid && !string.IsNullOrEmpty(uid)))
                            {
                                tempList.Add(el);
                            }
                        }
                    });
                }
            }

            // Resilient Fallback 2: Try GET_USERS without parameter restrictions
            if (tempList.Count == 0)
            {
                var fb2Payload = new APIDataAccParms
                {
                    ProcName = "sp_ticket_operations",
                    ProcID = "GET_USERS",
                    ComCod = "",
                    parm04 = "",
                    parm05 = ""
                };
                var fb2Result = await BackendApi.FetchDataAsync(fb2Payload);
                if (fb2Result.HasValue)
                {
                    ExtractItems(fb2Result.Value, el =>
                    {
                        var uid = GetPropString(el, "user_id", "id", "UserId", "Id");
                        var unm = GetPropString(el, "username", "userName", "UserName", "email", "Email");
                        if (!string.IsNullOrEmpty(uid) || !string.IsNullOrEmpty(unm))
                        {
                            if (!tempList.Any(x => GetPropString(x, "user_id", "id", "UserId", "Id") == uid && !string.IsNullOrEmpty(uid)))
                            {
                                tempList.Add(el);
                            }
                        }
                    });
                }
            }

            if (tempList.Count > 0)
            {
                userList = tempList;
            }
        }
        catch (Exception ex)
        {
            userErrorMessage = "LoadUsers error: " + ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

