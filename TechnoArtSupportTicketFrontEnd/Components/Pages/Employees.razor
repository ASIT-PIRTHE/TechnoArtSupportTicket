                            <!-- Assigned Projects -->
                            @if (pBadges.Any())
                            {
                                <div class="mb-2">
                                    <div class="small fw-semibold text-primary mb-1"><i class="bi bi-kanban me-1"></i>Projects:</div>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var pBadge in pBadges)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle small fw-semibold">@pBadge</span>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Assigned Modules -->
                            @if (mBadges.Any())
                            {
                                <div class="mb-2">
                                    <div class="small fw-semibold text-info mb-1"><i class="bi bi-diagram-3 me-1"></i>Modules:</div>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var mBadge in mBadges)
                                        {
                                            <span class="badge bg-info-subtle text-dark border border-info-subtle small">@mBadge</span>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Action Buttons -->
                            <div class="d-flex flex-wrap justify-content-end gap-1 pt-2 border-top mt-2">
                                @if (CanViewIdCard(user))
                                {
                                    <a href="@($"/admin/employees/{(string.IsNullOrEmpty(uId) ? "U1000000001" : uId)}/id-card")" class="btn btn-sm btn-outline-info" title="ID Card">
                                        <i class="bi bi-person-badge me-1"></i>ID Card
                                    </a>
                                }
                                @if (CanViewAppointmentLetter(user))
                                {
                                    <a href="@($"/admin/employees/{(string.IsNullOrEmpty(uId) ? "U1000000001" : uId)}/appointment-letter")" class="btn btn-sm btn-outline-success" title="Appointment Letter">
                                        <i class="bi bi-file-earmark-text me-1"></i>Letter
                                    </a>
                                }
                                @if (CanEditUser(user))
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick='() => StartEditUser(user)' title="Edit Profile">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </button>
                                }
                                @if (CanToggleUserStatus(user))
                                {
                                    <button class="btn btn-sm @(isAct ? "btn-outline-warning" : "btn-outline-success")" @onclick="() => ToggleUserActiveStatus(user)">
                                        <i class="bi @(isAct ? "bi-slash-circle" : "bi-check2-circle") me-1"></i>@(isAct ? "Deactivate" : "Activate")
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border rounded-3 p-4 text-center text-muted">
                <i class="bi bi-people fs-1 text-secondary opacity-50 d-block mb-2"></i>
                <div>No users registered matching your criteria.</div>
                @if (!string.IsNullOrEmpty(searchQuery) || !string.IsNullOrEmpty(selectedFilterTenant) || !string.IsNullOrEmpty(selectedFilterProject) || !string.IsNullOrEmpty(selectedFilterRole))
                {
                    <button class="btn btn-outline-secondary btn-sm mt-2" @onclick="ResetFilters">Reset Filters</button>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<JsonElement> userList = new();
    private List<JsonElement> tenantList = new();
    private List<JsonElement> projectList = new();
    private List<JsonElement> projectModules = new();

    public class RoleOption
    {
        [System.Text.Json.Serialization.JsonPropertyName("Key")]
        public string Key { get; set; } = "";

        [System.Text.Json.Serialization.JsonPropertyName("DisplayName")]
        public string DisplayName { get; set; } = "";

        [System.Text.Json.Serialization.JsonPropertyName("key_name")]
        public string KeyName { set => Key = value; }

        [System.Text.Json.Serialization.JsonPropertyName("RoleKey")]
        public string RoleKey { set => Key = value; }

        [System.Text.Json.Serialization.JsonPropertyName("display_name")]
        public string DispName { set => DisplayName = value; }

        [System.Text.Json.Serialization.JsonPropertyName("Name")]
        public string Name { set => DisplayName = value; }
    }

    private List<RoleOption> availableRoles = new()
    {
        new RoleOption { Key = "SuperAdmin", DisplayName = "Super Admin" },
        new RoleOption { Key = "MD", DisplayName = "Managing Director" },
        new RoleOption { Key = "SupportManager", DisplayName = "Support Manager" },
        new RoleOption { Key = "ProjectManager", DisplayName = "Project Manager" },
        new RoleOption { Key = "TeamMember", DisplayName = "Team Member (Engineer / Staff)" },
        new RoleOption { Key = "HRManager", DisplayName = "HR Manager" },
        new RoleOption { Key = "AccountsOfficer", DisplayName = "Accounts Officer" },
        new RoleOption { Key = "ClientAdmin", DisplayName = "Client Admin" },
        new RoleOption { Key = "ClientUser", DisplayName = "Client User" }
    };

    private bool isLoading = true;
    private bool isAddMode = false;
    private bool isSubmitting = false;

    // Logged in user claims context
    private string CurrentUserRole = "";
    private string CurrentUserTenantId = "";
    private string CurrentUserId = "";
    private string CurrentTenantName = "";

    // Filters & Search
    private string searchQuery = "";
    private string selectedFilterTenant = "";
    private string selectedFilterProject = "";
    private string selectedFilterRole = "";

    // Form Binding
    private string newFullName = "";
    private string newUsername = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private string newRole = "";
    private string newTenantId = "";
    private string newProjectId = "";
    private string newModuleId = "";
    private string? editUserId = null;
    private string userErrorMessage = "";

    // Multi-Selection State
    private HashSet<string> selectedProjectIds = new();
    private HashSet<string> selectedTenantIds = new();
    private HashSet<string> selectedModuleIds = new();

    // Shift & Attendance properties
    private TimeOnly? newShiftInTime = new TimeOnly(9, 30);
    private TimeOnly? newShiftOutTime = new TimeOnly(18, 30);
    private string newBloodGroup = "B+";
    private decimal newMonthlySalary = 0;
    private bool newIsWfhAllowed = true;

    // HR & Family Identity fields
    private string newPhone = "";
    private string newNationalId = "";
    private string newFatherName = "";
    private string newMotherName = "";
    private string newEmergencyContact = "";
    private string newEmergencyRelation = "";
    private string newDepartment = "Engineering";
    private string newDesignation = "";
    private DateTime? newJoiningDate = DateTime.Today;
    private string newBranchId = "";
    private List<JsonElement> branchList = new();
    private List<string> designationList = new();

    // -------------------------------------------------------------
    // BUTTON-LEVEL PERMISSIONS (Role & Tenant access based)
    // -------------------------------------------------------------
    private bool IsSuperAdmin => CurrentUserRole.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase) || CurrentUserRole.Equals("Admin", StringComparison.OrdinalIgnoreCase);
    private bool IsMD => CurrentUserRole.Equals("MD", StringComparison.OrdinalIgnoreCase);
    private bool IsHR => CurrentUserRole.Equals("HRManager", StringComparison.OrdinalIgnoreCase);
    private bool IsPM => CurrentUserRole.Equals("ProjectManager", StringComparison.OrdinalIgnoreCase);
    private bool IsClientAdmin => CurrentUserRole.Equals("ClientAdmin", StringComparison.OrdinalIgnoreCase);
    private bool IsInternalUser => !IsClientAdmin && !CurrentUserRole.Equals("ClientUser", StringComparison.OrdinalIgnoreCase);
    private bool IsClientUserRole(string? role) =>
        !string.IsNullOrEmpty(role) && 
        (string.Equals(role, "ClientAdmin", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(role, "ClientUser", StringComparison.OrdinalIgnoreCase));

    private bool CanCreateUser => IsSuperAdmin || IsMD || IsHR || (IsClientAdmin && !string.IsNullOrEmpty(CurrentUserTenantId));

    private bool CanEditUser(JsonElement user)
    {
        if (IsSuperAdmin || IsMD || IsHR) return true;
        if (IsClientAdmin)
        {
            var tid = GetPropString(user, "tenant_id", "TenantId");
            return !string.IsNullOrEmpty(tid) && string.Equals(tid, CurrentUserTenantId, StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }

    private bool CanViewIdCard(JsonElement user)
    {
        var r = GetPropString(user, "role", "Role");
        bool isClient = r.StartsWith("Client", StringComparison.OrdinalIgnoreCase);
        return (IsSuperAdmin || IsMD || IsHR) && !isClient;
    }

    private bool CanViewAppointmentLetter(JsonElement user)
    {
        var r = GetPropString(user, "role", "Role");
        bool isClient = r.StartsWith("Client", StringComparison.OrdinalIgnoreCase);
        return (IsSuperAdmin || IsMD || IsHR) && !isClient;
    }

    private bool CanToggleUserStatus(JsonElement user)
    {
        if (IsSuperAdmin || IsMD || IsHR) return true;
        if (IsClientAdmin)
        {
            var tid = GetPropString(user, "tenant_id", "TenantId");
            return !string.IsNullOrEmpty(tid) && string.Equals(tid, CurrentUserTenantId, StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }

    private bool CanViewSalary => IsSuperAdmin || IsMD || IsHR;

    // -------------------------------------------------------------
    // ACCESSIBLE ENTITY COLLECTIONS
    // -------------------------------------------------------------
    private IEnumerable<JsonElement> AccessibleTenants =>
        IsInternalUser
            ? tenantList
            : tenantList.Where(t => string.Equals(GetPropString(t, "tenant_id", "id"), CurrentUserTenantId, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<RoleOption> FilteredAvailableRoles =>
        IsClientAdmin
            ? availableRoles.Where(r => r.Key == "ClientUser")
            : availableRoles;

    private IEnumerable<JsonElement> FilteredProjects
    {
        get
        {
            var activeTenants = new HashSet<string>(selectedTenantIds, StringComparer.OrdinalIgnoreCase);
            if (!string.IsNullOrEmpty(newTenantId)) activeTenants.Add(newTenantId);

            if (activeTenants.Count > 0)
            {
                return projectList.Where(p => {
                    var tid = GetPropString(p, "tenant_id", "TenantId");
                    return string.IsNullOrEmpty(tid) || activeTenants.Contains(tid);
                });
            }

            return IsInternalUser 
                ? projectList 
                : projectList.Where(p => string.Equals(GetPropString(p, "tenant_id", "TenantId"), CurrentUserTenantId, StringComparison.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<JsonElement> DisplayedUserList
    {
        get
        {
            var list = userList.AsEnumerable();

            // 1. Follow User Tenant Access
            if (!IsInternalUser && !string.IsNullOrEmpty(CurrentUserTenantId))
            {
                list = list.Where(u => {
                    var tid = GetPropString(u, "tenant_id", "TenantId");
                    if (!string.IsNullOrEmpty(tid) && string.Equals(tid, CurrentUserTenantId, StringComparison.OrdinalIgnoreCase))
                        return true;
                    // Check if assigned in user's tenant projects
                    if (u.TryGetProperty("tenants", out var tArr) && tArr.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var el in tArr.EnumerateArray())
                        {
                            var tStr = el.ValueKind == JsonValueKind.String ? el.GetString() : GetPropString(el, "tenant_id", "id");
                            if (string.Equals(tStr, CurrentUserTenantId, StringComparison.OrdinalIgnoreCase)) return true;
                        }
                    }
                    return false;
                });
            }

            // 2. Filter by Tenant Dropdown
            if (!string.IsNullOrEmpty(selectedFilterTenant))
            {
                if (selectedFilterTenant == "INTERNAL")
                {
                    list = list.Where(u => {
                        var tid = GetPropString(u, "tenant_id", "TenantId");
                        return string.IsNullOrEmpty(tid) || tid == "00000000-0000-0000-0000-000000000000" || string.Equals(tid, "T001", StringComparison.OrdinalIgnoreCase);
                    });
                }
                else
                {
                    list = list.Where(u => {
                        var tid = GetPropString(u, "tenant_id", "TenantId");
                        if (string.Equals(tid, selectedFilterTenant, StringComparison.OrdinalIgnoreCase)) return true;
                        if (u.TryGetProperty("tenants", out var tArr) && tArr.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var el in tArr.EnumerateArray())
                            {
                                var tStr = el.ValueKind == JsonValueKind.String ? el.GetString() : GetPropString(el, "tenant_id", "id");
                                if (string.Equals(tStr, selectedFilterTenant, StringComparison.OrdinalIgnoreCase)) return true;
                            }
                        }
                        return false;
                    });
                }
            }

            // 3. Filter by Project Dropdown
            if (!string.IsNullOrEmpty(selectedFilterProject))
            {
                list = list.Where(u => {
                    var pid = GetPropString(u, "project_id", "ProjectId");
                    if (string.Equals(pid, selectedFilterProject, StringComparison.OrdinalIgnoreCase)) return true;
                    if (u.TryGetProperty("projects", out var pArr) && pArr.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var el in pArr.EnumerateArray())
                        {
                            var pStr = el.ValueKind == JsonValueKind.String ? el.GetString() : GetPropString(el, "project_id", "id");
                            if (string.Equals(pStr, selectedFilterProject, StringComparison.OrdinalIgnoreCase)) return true;
                        }
                    }
                    return false;
                });
            }

            // 4. Filter by Role Dropdown
            if (!string.IsNullOrEmpty(selectedFilterRole))
            {
                list = list.Where(u => string.Equals(GetPropString(u, "role", "Role"), selectedFilterRole, StringComparison.OrdinalIgnoreCase));
            }

            // 5. Search Query Filter
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                list = list.Where(u => {
                    var name = GetPropString(u, "full_name", "name", "FullName");
                    var username = GetPropString(u, "username", "userName", "email");
                    var phone = GetPropString(u, "phone", "Phone");
                    var desig = GetPropString(u, "designation", "Designation");
                    return name.Contains(q, StringComparison.OrdinalIgnoreCase)
                        || username.Contains(q, StringComparison.OrdinalIgnoreCase)
                        || phone.Contains(q, StringComparison.OrdinalIgnoreCase)
                        || desig.Contains(q, StringComparison.OrdinalIgnoreCase);
                });
            }

            return list;
        }
    }

