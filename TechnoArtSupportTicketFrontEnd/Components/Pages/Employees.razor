        try { await LoadDynamicRoles(); } catch {}
        try { await LoadTenants(); } catch {}
        try { await LoadProjects(); } catch {}
        try { await LoadBranches(); } catch {}
        try { LoadDesignations(); } catch {}
        await LoadUsers();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && (string.IsNullOrEmpty(CurrentUserRole) || userList.Count == 0))
        {
            await ResolveUserAuthContext();
            await LoadUsers();
            StateHasChanged();
        }
    }

    private async Task ResolveUserAuthContext()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        CurrentUserRole = user.FindFirst(ClaimTypes.Role)?.Value 
            ?? user.FindFirst("role")?.Value 
            ?? user.FindFirst("Role")?.Value 
            ?? "";
        CurrentUserTenantId = user.FindFirst("TenantId")?.Value 
            ?? user.FindFirst("tenant_id")?.Value 
            ?? user.FindFirst("Tenant")?.Value 
            ?? user.FindFirst("tenant")?.Value 
            ?? "";
        CurrentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value 
            ?? user.FindFirst("nameid")?.Value 
            ?? user.FindFirst("id")?.Value 
            ?? user.FindFirst("user_id")?.Value 
            ?? "";

        if (!string.IsNullOrEmpty(CurrentUserTenantId) && tenantList.Count > 0)
        {
            var match = tenantList.FirstOrDefault(t => string.Equals(GetPropString(t, "tenant_id", "id"), CurrentUserTenantId, StringComparison.OrdinalIgnoreCase));
            CurrentTenantName = GetPropString(match, "name", "tenant_name");
        }
    }

