    private string FormatShiftTiming(JsonElement user)
    {
        var sIn = GetPropString(user, "shift_in", "CustomStartTime");
        var sOut = GetPropString(user, "shift_out", "CustomEndTime");
        var timing = GetPropString(user, "shift_timing", "ShiftTiming");

        string inFmt = FormatTime12(sIn);
        string outFmt = FormatTime12(sOut);

        if (!string.IsNullOrEmpty(inFmt) && !string.IsNullOrEmpty(outFmt))
        {
            return $"{inFmt} - {outFmt}";
        }
        if (!string.IsNullOrEmpty(timing))
        {
            if (timing.Contains('-'))
            {
                var parts = timing.Split('-');
                var p1 = FormatTime12(parts[0].Trim());
                var p2 = FormatTime12(parts[1].Trim());
                if (!string.IsNullOrEmpty(p1) && !string.IsNullOrEmpty(p2)) return $"{p1} - {p2}";
            }
            return FormatTime12(timing);
        }
        return "09:30 AM - 06:30 PM";
    }

    private static string FormatTime12(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return "";
        if (TimeOnly.TryParse(val, out var to)) return to.ToString("hh:mm tt");
        if (DateTime.TryParse(val, out var dt)) return dt.ToString("hh:mm tt");
        return val;
    }

    // -------------------------------------------------------------
    // SAFE JSON CONVERTERS
    // -------------------------------------------------------------
    private static string GetPropString(JsonElement el, params string[] propertyNames)
    {
        if (el.ValueKind != JsonValueKind.Object) return "";
        foreach (var name in propertyNames)
        {
            if (el.TryGetProperty(name, out var prop))
            {
                return prop.ValueKind switch
                {
                    JsonValueKind.String => prop.GetString() ?? "",
                    JsonValueKind.Number => prop.ToString(),
                    JsonValueKind.True => "true",
                    JsonValueKind.False => "false",
                    JsonValueKind.Null => "",
                    _ => prop.ToString()
                };
            }
        }
        return "";
    }

    private static decimal GetPropDecimal(JsonElement el, decimal defaultValue, params string[] propertyNames)
    {
        if (el.ValueKind != JsonValueKind.Object) return defaultValue;
        foreach (var name in propertyNames)
        {
            if (el.TryGetProperty(name, out var prop))
            {
                if (prop.ValueKind == JsonValueKind.Number && prop.TryGetDecimal(out var d)) return d;
                if (prop.ValueKind == JsonValueKind.String && decimal.TryParse(prop.GetString(), out var ps)) return ps;
            }
        }
        return defaultValue;
    }

    private static bool GetPropBool(JsonElement el, bool defaultValue, params string[] propertyNames)
    {
        if (el.ValueKind != JsonValueKind.Object) return defaultValue;
        foreach (var name in propertyNames)
        {
            if (el.TryGetProperty(name, out var prop))
            {
                if (prop.ValueKind == JsonValueKind.True) return true;
                if (prop.ValueKind == JsonValueKind.False) return false;
                if (prop.ValueKind == JsonValueKind.Number) return prop.GetInt32() == 1;
                if (prop.ValueKind == JsonValueKind.String && bool.TryParse(prop.GetString(), out var b)) return b;
            }
        }
        return defaultValue;
    }
