    private async Task StartEditUser(JsonElement u)
    {
        var id = GetPropString(u, "user_id", "id", "UserId", "Id");
        var name = GetPropString(u, "full_name", "name", "FullName", "Name");
        var username = GetPropString(u, "username", "userName", "UserName", "email", "Email");
        var role = GetPropString(u, "role", "Role");
        var tenantId = GetPropString(u, "tenant_id", "TenantId");
        var projectId = GetPropString(u, "project_id", "ProjectId");
        var moduleId = GetPropString(u, "module_id", "ModuleId");

        editUserId = id;
        newFullName = name;
        newUsername = username;
        newRole = role;
        newTenantId = tenantId;
        newProjectId = projectId;
        newModuleId = moduleId;
        newPassword = "";
        confirmPassword = "";
        userErrorMessage = "";

        selectedProjectIds.Clear();
        if (!string.IsNullOrEmpty(newProjectId)) selectedProjectIds.Add(newProjectId);
        if (u.ValueKind == JsonValueKind.Object && u.TryGetProperty("projects", out var projsEl) && projsEl.ValueKind == JsonValueKind.Array)
        {
            foreach (var p in projsEl.EnumerateArray())
            {
                var pid = p.ValueKind == JsonValueKind.String ? p.GetString() : GetPropString(p, "project_id", "id");
                if (!string.IsNullOrEmpty(pid)) selectedProjectIds.Add(pid);
            }
        }

        selectedTenantIds.Clear();
        if (!string.IsNullOrEmpty(newTenantId)) selectedTenantIds.Add(newTenantId);
        if (u.ValueKind == JsonValueKind.Object && u.TryGetProperty("tenants", out var tensEl) && tensEl.ValueKind == JsonValueKind.Array)
        {
            foreach (var t in tensEl.EnumerateArray())
            {
                var tid = t.ValueKind == JsonValueKind.String ? t.GetString() : GetPropString(t, "tenant_id", "id");
                if (!string.IsNullOrEmpty(tid)) selectedTenantIds.Add(tid);
            }
        }

        selectedModuleIds.Clear();
        if (!string.IsNullOrEmpty(newModuleId)) selectedModuleIds.Add(newModuleId);
        if (u.ValueKind == JsonValueKind.Object && u.TryGetProperty("modules", out var modsEl) && modsEl.ValueKind == JsonValueKind.Array)
        {
            foreach (var m in modsEl.EnumerateArray())
            {
                var mid = m.ValueKind == JsonValueKind.String ? m.GetString() : GetPropString(m, "module_id", "id");
                if (!string.IsNullOrEmpty(mid)) selectedModuleIds.Add(mid);
            }
        }

        newPhone = GetPropString(u, "phone", "Phone");
        newNationalId = GetPropString(u, "national_id", "NationalId");
        newFatherName = GetPropString(u, "father_name", "FatherName");
        newMotherName = GetPropString(u, "mother_name", "MotherName");
        newEmergencyContact = GetPropString(u, "emergency_contact", "EmergencyContact");
        newEmergencyRelation = GetPropString(u, "emergency_relation", "EmergencyContactRelation");
        newDepartment = GetPropString(u, "department", "Department");
        if (string.IsNullOrEmpty(newDepartment)) newDepartment = "Engineering";
        newDesignation = GetPropString(u, "designation", "Designation");
        var jd = GetPropString(u, "joining_date", "JoiningDate", "JoinDate");
        if (!string.IsNullOrEmpty(jd) && DateTime.TryParse(jd, out var parsedJd)) newJoiningDate = parsedJd;
        else newJoiningDate = DateTime.Today;

        newBranchId = GetPropString(u, "branch_id", "BranchId");
        var bg = GetPropString(u, "blood_group", "BloodGroup");
        newBloodGroup = !string.IsNullOrEmpty(bg) ? bg : "B+";

        newMonthlySalary = GetPropDecimal(u, 0, "gross_salary", "GrossSalary", "salary", "Salary");

        var si = GetPropString(u, "shift_in", "CustomStartTime");
        if (string.IsNullOrEmpty(si))
        {
            var st = GetPropString(u, "shift_timing", "ShiftTiming");
            if (st.Contains('-')) si = st.Split('-')[0].Trim();
            else si = st;
        }
        if (!string.IsNullOrEmpty(si))
        {
            if (TimeOnly.TryParse(si, out var parsedSi)) newShiftInTime = parsedSi;
            else if (DateTime.TryParse(si, out var parsedSiDt)) newShiftInTime = TimeOnly.FromDateTime(parsedSiDt);
            else newShiftInTime = new TimeOnly(9, 30);
        }
        else newShiftInTime = new TimeOnly(9, 30);

        var so = GetPropString(u, "shift_out", "CustomEndTime");
        if (string.IsNullOrEmpty(so))
        {
            var st = GetPropString(u, "shift_timing", "ShiftTiming");
            if (st.Contains('-')) so = st.Split('-')[1].Trim();
        }
        if (!string.IsNullOrEmpty(so))
        {
            if (TimeOnly.TryParse(so, out var parsedSo)) newShiftOutTime = parsedSo;
            else if (DateTime.TryParse(so, out var parsedSoDt)) newShiftOutTime = TimeOnly.FromDateTime(parsedSoDt);
            else newShiftOutTime = new TimeOnly(18, 30);
        }
        else newShiftOutTime = new TimeOnly(18, 30);

        newIsWfhAllowed = GetPropBool(u, true, "is_wfh_allowed", "IsWfhAllowed");

        isAddMode = true;
        await RefreshAvailableModules();
        StateHasChanged();
    }

