    private async Task RefreshAvailableModules()
    {
        projectModules.Clear();
        var projectsToLoad = selectedProjectIds.ToList();
        if (!string.IsNullOrEmpty(newProjectId) && !projectsToLoad.Contains(newProjectId))
        {
            projectsToLoad.Add(newProjectId);
        }

        foreach (var pid in projectsToLoad)
        {
            try
            {
                var payload = new APIDataAccParms
                {
                    ProcID = "GET_PROJECT_MODULES",
                    parm01 = pid,
                    parm04 = CurrentUserId,
                    parm05 = CurrentUserRole
                };
                var result = await BackendApi.FetchDataAsync(payload);
                if (result.HasValue)
                {
                    ExtractItems(result.Value, el =>
                    {
                        var mid = GetPropString(el, "module_id", "id");
                        if (!string.IsNullOrEmpty(mid) && !projectModules.Any(m => GetPropString(m, "module_id", "id") == mid))
                        {
                            projectModules.Add(el);
                        }
                    });
                }
            }
            catch { }
        }
        StateHasChanged();
    }

