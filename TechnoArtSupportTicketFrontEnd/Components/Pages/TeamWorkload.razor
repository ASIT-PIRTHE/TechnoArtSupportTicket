@page "/team-workload"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using TechnoArtSupportTicketFrontEnd.Services
@using System.Text.Json
@attribute [Authorize(Roles = "SuperAdmin,MD,SupportManager,ProjectManager")]
@inject ApiService BackendApi

<PageTitle>Team Workload</PageTitle>

<div class="custom-card p-3 p-md-4 h-100" style="max-width: 100%; overflow-x: hidden;">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h5 class="fw-bold m-0"><i class="bi bi-person-lines-fill text-primary me-2"></i> Team Workload & Task Tracker</h5>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var workload in workloadByAssignee)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card shadow-sm border-0 h-100 border-top border-4 border-info">
                        <div class="card-body p-3 p-md-4">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="avatar-circle">@(string.IsNullOrEmpty(workload.Key) ? "?" : workload.Key[..2].ToUpper())</div>
                                <div>
                                    <h6 class="fw-bold mb-0">@(string.IsNullOrEmpty(workload.Key) ? "Unassigned Pool" : workload.Key)</h6>
                                    <div class="small text-muted">@workload.Value.Count tasks in flight</div>
                                </div>
                            </div>
                            
                            <ul class="list-group list-group-flush small">
                                @foreach(var tk in workload.Value.Take(4))
                                {
                                    var stat = tk.GetProperty("status").GetString() ?? "";
                                    <li class="list-group-item px-0 d-flex justify-content-between">
                                        <div class="text-truncate flex-grow-1" style="max-width:200px;">@tk.GetProperty("name").GetString()</div>
                                        <span class="badge @(stat == "IN_PROGRESS" ? "bg-warning text-dark" : "bg-light text-dark border")">@stat</span>
                                    </li>
                                }
                                @if(workload.Value.Count > 4)
                                {
                                    <li class="list-group-item px-0 text-center text-primary pt-2 border-0">+ @(workload.Value.Count - 4) more</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
            
            @if (workloadByAssignee.Count == 0)
            {
                <div class="col-12 text-center text-muted p-5 bg-light rounded">No active tasks found.</div>
            }
        </div>
    }
</div>

@code {
    private Dictionary<string, List<JsonElement>> workloadByAssignee = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var payload = new APIDataAccParms { ProcID = "GET_TASKS" };
        var result = await BackendApi.FetchDataAsync(payload);
        if (result.HasValue)
        {
            try {
                if (result.Value.ValueKind == JsonValueKind.Array)
                {
                    foreach (var el in result.Value.EnumerateArray())
                    {
                        var assignee = el.TryGetProperty("assigned_to", out var a) && a.ValueKind != JsonValueKind.Null ? a.GetString() ?? "Unassigned" : "Unassigned";
                        if (!workloadByAssignee.ContainsKey(assignee)) workloadByAssignee[assignee] = new List<JsonElement>();
                        workloadByAssignee[assignee].Add(el);
                    }
                }
            } catch {}
        }
        isLoading = false;
    }
}
