@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Configuration
@inject IConfiguration Config

<div class="sidebar-logo">
    <i class="bi bi-headset"></i> @(Config["Branding:SiteName"] ?? "SupportHub")
</div>

<div class="sidebar-menu mt-2 pb-4 overflow-auto" style="height: calc(100vh - 80px);">
    
    <div class="nav-section-title">Navigation</div>
    
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
        <i class="bi bi-grid-1x2"></i> Dashboard
    </NavLink>
    
    <AuthorizeView Roles="SuperAdmin,MD">
        <NavLink class="nav-link" href="admin/clients">
            <i class="bi bi-building"></i> Clients & Tenants
        </NavLink>
        <NavLink class="nav-link" href="admin/employees">
            <i class="bi bi-people"></i> User Management
        </NavLink>
        
        <div class="nav-section-title">Management</div>
        <NavLink class="nav-link" href="admin/reports">
            <i class="bi bi-bar-chart"></i> Executive Reports
        </NavLink>
    </AuthorizeView>

    <AuthorizeView Roles="ProjectManager,SupportManager,SuperAdmin,MD,ClientAdmin,ClientUser">
        <div class="nav-section-title">Projects & Teams</div>
        <NavLink class="nav-link" href="projects">
            <i class="bi bi-kanban"></i> Projects
        </NavLink>
    </AuthorizeView>

    <AuthorizeView Roles="ProjectManager,SupportManager,SuperAdmin">
        <NavLink class="nav-link" href="all-tickets">
            <i class="bi bi-inboxes"></i> Ticket Queue
        </NavLink>
        <NavLink class="nav-link" href="team-workload">
            <i class="bi bi-person-lines-fill"></i> Team Workload
        </NavLink>
    </AuthorizeView>

    <AuthorizeView Roles="TeamMember,ProjectManager,SupportManager,SuperAdmin,MD">
        <div class="nav-section-title">My Work</div>
        <NavLink class="nav-link" href="raise-ticket">
            <i class="bi bi-ticket-plus"></i> Raise a Ticket
        </NavLink>
        <NavLink class="nav-link" href="my-tickets">
            <i class="bi bi-ticket"></i> My Tickets
        </NavLink>
        <NavLink class="nav-link" href="my-tasks">
            <i class="bi bi-list-task"></i> My Tasks
        </NavLink>
    </AuthorizeView>

    <AuthorizeView Roles="ClientAdmin,ClientUser">
        <div class="nav-section-title">Support Desk</div>
        <NavLink class="nav-link" href="raise-ticket">
            <i class="bi bi-ticket-plus"></i> Raise a Ticket
        </NavLink>
        <NavLink class="nav-link" href="client/my-tickets">
            <i class="bi bi-ticket"></i> My Tickets
        </NavLink>
    </AuthorizeView>
    
    <AuthorizeView Roles="ClientAdmin">
        <NavLink class="nav-link" href="admin/employees">
            <i class="bi bi-people"></i> Company Users
        </NavLink>
    </AuthorizeView>

    <div class="nav-section-title mt-4">Account</div>
    <NavLink class="nav-link" href="settings">
        <i class="bi bi-gear"></i> Settings
    </NavLink>
</div>
