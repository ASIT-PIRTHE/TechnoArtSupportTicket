@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject TechnoArtSupportTicketFrontEnd.Services.ApiService BackendApi
@inject IConfiguration Config
@inject IJSRuntime JS

<div class="page bg-light-surface w-100" style="min-height: 100vh; overflow-x: hidden; max-width: 100vw;">
    <AuthorizeView>
        <Authorized>
            <!-- Vertical Sidebar Navigation -->
            <div class="sidebar-wrapper shadow-sm @(isSidebarOpen ? "show" : "")">
                <NavMenu />
            </div>

            <!-- Overlay for mobile sidebar -->
            @if(isSidebarOpen) {
                <div class="d-md-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50" style="z-index: 999;" @onclick="ToggleSidebar"></div>
            }

            <!-- Main Content Container -->
            <main class="main-wrapper">
                <!-- Clean Top Header -->
                <header class="top-header">
                    <div class="d-flex align-items-center position-relative">
                        <button class="btn btn-light d-md-none me-2" @onclick="ToggleSidebar">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        @if (IsTicketPage)
                        {
                            <div class="position-relative d-none d-md-flex align-items-center ms-2" style="width: 320px;">
                                <i class="bi bi-search text-muted position-absolute start-0 ms-3" style="z-index: 2; pointer-events: none;"></i>
                                <input type="text" class="form-control rounded-pill ps-5 bg-light border-0 small" placeholder="Search Tickets (e.g. TIC-...)" @bind="searchQuery" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" />
                            </div>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-2 gap-sm-3">
                        <!-- PWA Install App Button -->
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold d-flex align-items-center gap-1 shadow-sm" @onclick="TriggerPwaInstall" title="Install App to Device / Home Screen">
                            <i class="bi bi-download"></i>
                            <span class="d-none d-sm-inline">Install App</span>
                        </button>

                        <!-- Notification Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-link text-muted position-relative p-0 border-0" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" @onclick="LoadNotifications">
                                <i class="bi bi-bell fs-5"></i>
                                @if (unreadCount > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                                        @unreadCount
                                    </span>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-0" aria-labelledby="notifDropdown" style="width: 340px; max-height: 400px; overflow-y: auto;">
                                <li class="p-3 bg-light border-bottom fw-bold d-flex justify-content-between align-items-center">
                                    <span>Notifications</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary rounded-pill">@unreadCount New</span>
                                        @if (unreadCount > 0)
                                        {
                                            <button class="btn btn-link btn-sm p-0 text-decoration-none small text-primary fw-semibold" @onclick="MarkAllNotificationsAsRead" title="Mark all notifications as read">
                                                <i class="bi bi-check2-all me-1"></i> Mark all read
                                            </button>
                                        }
                                    </div>
                                </li>
                                @if (notifications.Count == 0 && !isLoadingNotif)
                                {
                                    <li class="p-4 text-center text-muted small"><i class="bi bi-bell-slash fs-4 d-block mb-2 text-light"></i>No notifications yet.</li>
                                }
                                else if (isLoadingNotif)
                                {
                                    <li class="p-3 text-center text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</li>
                                }
                                else
                                {
                                    @foreach (var n in notifications)
                                    {
                                        var isRead = n.TryGetProperty("is_read", out var r) && (r.ValueKind == JsonValueKind.True || (r.ValueKind == JsonValueKind.Number && r.GetInt32() == 1));
                                        var nid = 0;
                                        if (n.TryGetProperty("id", out var idEl))
                                        {
                                            if (idEl.ValueKind == JsonValueKind.Number) nid = idEl.GetInt32();
                                            else if (idEl.ValueKind == JsonValueKind.String && int.TryParse(idEl.GetString(), out var parsedId)) nid = parsedId;
                                        }
                                        var title = n.TryGetProperty("title", out var tEl) && tEl.ValueKind == JsonValueKind.String ? tEl.GetString() : "Notice";
                                        var createdAt = n.TryGetProperty("created_at", out var cEl) && cEl.ValueKind == JsonValueKind.String ? cEl.GetString() : "";
                                        var message = n.TryGetProperty("message", out var mEl) && mEl.ValueKind == JsonValueKind.String ? mEl.GetString() : "";
                                        <li class="p-3 border-bottom @(!isRead ? "bg-primary bg-opacity-10" : "")" style="cursor:pointer;" @onclick="() => ReadNotification(nid)">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="fw-semibold text-dark small mb-1">
                                                    @if(!isRead) { <span class="badge bg-danger rounded-circle p-1 me-1"> </span> }
                                                    @title
                                                </div>
                                                <small class="text-muted" style="font-size: 0.65rem;">@createdAt</small>
                                            </div>
                                            <div class="small text-muted" style="font-size: 0.8rem; line-height: 1.3;">@message</div>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                        <div class="dropdown">
                            <div class="d-flex align-items-center gap-2 cursor-pointer" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                                <div class="avatar-circle">
                                    @(context.User.Identity?.Name?.Substring(0, 1) ?? "U")
                                </div>
                                <div class="d-none d-md-block">
                                    <div class="fw-semibold" style="font-size:0.9rem; line-height:1;">@context.User.Identity?.Name</div>
                                    <small class="text-muted" style="font-size:0.75rem;">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                                </div>
                                <i class="bi bi-chevron-down text-muted ms-1" style="font-size: 0.8rem;"></i>
                            </div>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="profile"><i class="bi bi-person me-2"></i> Profile</a></li>
                                <li><a class="dropdown-item" href="settings"><i class="bi bi-gear me-2"></i> Settings</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><button class="dropdown-item text-danger" @onclick="Logout"><i class="bi bi-box-arrow-right me-2"></i> Logout</button></li>
                            </ul>
                        </div>
                    </div>
                </header>

                <article class="p-2 p-sm-3 p-md-4 d-flex flex-column" style="flex:1; min-width: 0; overflow-x: hidden; max-width: 100%;">
                    <div style="flex:1; min-width: 0; max-width: 100%; overflow-x: hidden;">
                        @Body
                    </div>
                    <footer class="mt-5 border-top pt-3 text-center text-muted small">
                        &copy; @DateTime.Now.Year <a href="@(Config["Branding:CompanyUrl"] ?? "#")" target="_blank" class="text-decoration-none fw-bold">@(Config["Branding:CompanyName"] ?? "Support Company")</a>. 
                        Need help? Contact <a href="mailto:@(Config["Branding:SupportEmail"] ?? "support@domain.com")">@(Config["Branding:SupportEmail"] ?? "support@domain.com")</a>
                    </footer>
                </article>
            </main>
        </Authorized>
        <NotAuthorized>
            @if (IsPublicPage())
            {
                <!-- Render only body for Login / Public page without sidebar -->
                <main>
                    <article>
                        @Body
                    </article>
                </main>
            }
            else
            {
                <!-- Force redirect to Login if unauthenticated user attempts to access any internal page -->
                <RedirectToLogin />
            }
        </NotAuthorized>
    </AuthorizeView>
    <MudThemeProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <!-- PWA Install Guide Modal -->
    @if (showPwaGuideModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1050;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header border-bottom bg-primary text-white">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-phone me-2"></i>Install TAS Support App
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => showPwaGuideModal = false"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="text-center mb-4">
                            <div class="avatar-circle bg-primary text-white mx-auto mb-2" style="width: 60px; height: 60px; font-size: 1.5rem;">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <h6 class="fw-bold mb-1">TechnoArt Support & HR Portal</h6>
                            <p class="text-muted small mb-0">Install this progressive web app for instant access, offline mode & geofence attendance.</p>
                        </div>

                        <div class="list-group list-group-flush mb-3">
                            <div class="list-group-item d-flex align-items-start gap-3 px-0 py-3">
                                <div class="badge bg-light text-primary border rounded-circle p-2 fs-5"><i class="bi bi-android2"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-1">On Android (Chrome / Edge)</h6>
                                    <p class="small text-muted mb-0">Tap the <strong>3 dots (⋮)</strong> menu at the top right of your browser, then tap <strong>"Install app"</strong> or <strong>"Add to Home screen"</strong>.</p>
                                </div>
                            </div>
                            <div class="list-group-item d-flex align-items-start gap-3 px-0 py-3">
                                <div class="badge bg-light text-dark border rounded-circle p-2 fs-5"><i class="bi bi-apple"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-1">On iPhone / iPad (Safari)</h6>
                                    <p class="small text-muted mb-0">Tap the <strong>Share</strong> button (<i class="bi bi-box-arrow-up"></i>) at the bottom toolbar, scroll down and tap <strong>"Add to Home Screen"</strong>.</p>
                                </div>
                            </div>
                            <div class="list-group-item d-flex align-items-start gap-3 px-0 py-3">
                                <div class="badge bg-light text-info border rounded-circle p-2 fs-5"><i class="bi bi-laptop"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-1">On Windows / Mac (Desktop)</h6>
                                    <p class="small text-muted mb-0">Look for the <strong>Install</strong> icon in the address bar (or click browser menu ⋮ -> <strong>Cast, save and share -> Install TechnoArt</strong>).</p>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info py-2 small mb-0">
                            <i class="bi bi-info-circle me-1"></i> Tip: Running over <strong>HTTPS</strong> enables 1-click automatic install.
                        </div>
                    </div>
                    <div class="modal-footer border-top bg-light">
                        <button type="button" class="btn btn-primary fw-semibold w-100" @onclick="() => showPwaGuideModal = false">
                            Got It
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isSidebarOpen = false;
    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;

    private bool showPwaGuideModal = false;

    private async Task TriggerPwaInstall()
    {
        try
        {
            var prompted = await JS.InvokeAsync<bool>("installPwaApp");
            if (!prompted)
            {
                showPwaGuideModal = true;
            }
        }
        catch
        {
            showPwaGuideModal = true;
        }
    }

    private string searchQuery = "";
    private bool IsTicketPage
    {
        get
        {
            var uri = NavigationManager.Uri.ToLowerInvariant();
            return uri.Contains("/all-tickets") || uri.Contains("/my-tickets") || uri.Contains("/client/my-tickets") || uri.Contains("/ticket");
        }
    }

    private bool IsPublicPage()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
        var cleanPath = relative.Split('?')[0].Trim('/');
        return cleanPath == "login" || cleanPath == "error" || cleanPath == "forgot-password" || cleanPath == "reset-password";
    }



    private List<JsonElement> notifications = new();
    private int unreadCount = 0;
    private bool isLoadingNotif = false;
    private System.Threading.Timer? notifTimer;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await FetchUnreadCount();
            notifTimer = new System.Threading.Timer(async (e) => {
                await InvokeAsync(async () => {
                    await FetchUnreadCount();
                    StateHasChanged();
                });
            }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        }
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ExecuteSearch();
        }
    }

    private void ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        var q = searchQuery.Trim();
        if (q.StartsWith("TIC-", StringComparison.OrdinalIgnoreCase) || q.Contains("-202"))
        {
            NavigationManager.NavigateTo($"/ticket/{q}");
        }
        else
        {
            NavigationManager.NavigateTo($"/all-tickets?q={Uri.EscapeDataString(q)}");
        }
    }

    private async Task FetchUnreadCount()
    {
        try
        {
            var payload = new TechnoArtSupportTicketFrontEnd.Services.APIDataAccParms { ProcID = "GET_UNREAD_COUNT" };
            var res = await BackendApi.FetchDataAsync(payload);
            if (res.HasValue)
            {
                var el = res.Value;
                if (el.ValueKind == JsonValueKind.Object && el.TryGetProperty("Table", out var tbl) && tbl.ValueKind == JsonValueKind.Array)
                {
                    el = tbl;
                }
                else if (el.ValueKind == JsonValueKind.Object && el.TryGetProperty("data", out var dt) && dt.ValueKind == JsonValueKind.Array)
                {
                    el = dt;
                }

                if (el.ValueKind == JsonValueKind.Array)
                {
                    if (el.GetArrayLength() > 0)
                    {
                        var first = el[0];
                        if (first.ValueKind == JsonValueKind.Object && (first.TryGetProperty("unread_count", out var c) || first.TryGetProperty("count", out c) || first.TryGetProperty("UnreadCount", out c)))
                        {
                            unreadCount = c.ValueKind == JsonValueKind.Number ? c.GetInt32() : (int.TryParse(c.GetString(), out var parsed) ? parsed : 0);
                        }
                    }
                    else
                    {
                        unreadCount = 0;
                    }
                }
                else if (el.ValueKind == JsonValueKind.Object)
                {
                    if (el.TryGetProperty("unread_count", out var c) || el.TryGetProperty("count", out c) || el.TryGetProperty("UnreadCount", out c))
                    {
                        unreadCount = c.ValueKind == JsonValueKind.Number ? c.GetInt32() : (int.TryParse(c.GetString(), out var parsed) ? parsed : 0);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching unread count: {ex.Message}");
            unreadCount = 0;
        }
    }

    private async Task LoadNotifications()
    {
        isLoadingNotif = true;
        notifications.Clear();
        StateHasChanged();

        try
        {
            var payload = new TechnoArtSupportTicketFrontEnd.Services.APIDataAccParms { ProcID = "GET_NOTIFICATIONS" };
            var res = await BackendApi.FetchDataAsync(payload);
            if (res.HasValue)
            {
                void AddNotif(JsonElement el)
                {
                    if (el.ValueKind == JsonValueKind.Array)
                        foreach (var s in el.EnumerateArray()) AddNotif(s);
                    else if (el.ValueKind == JsonValueKind.Object)
                    {
                        if (el.TryGetProperty("Table", out var t) && t.ValueKind == JsonValueKind.Array)
                            foreach (var s in t.EnumerateArray()) AddNotif(s);
                        else if (el.TryGetProperty("data", out var d) && d.ValueKind == JsonValueKind.Array)
                            foreach (var s in d.EnumerateArray()) AddNotif(s);
                        else
                            notifications.Add(el);
                    }
                }
                AddNotif(res.Value);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading notifications: {ex.Message}");
        }
        finally
        {
            isLoadingNotif = false;
            StateHasChanged();
        }
    }

    private async Task ReadNotification(int id)
    {
        try
        {
            var payload = new TechnoArtSupportTicketFrontEnd.Services.APIDataAccParms { ProcID = "READ_NOTIFICATION", parm01 = id.ToString() };
            await BackendApi.FetchDataAsync(payload);
            await LoadNotifications();
            await FetchUnreadCount();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in ReadNotification: {ex.Message}");
        }
    }

    private async Task MarkAllNotificationsAsRead()
    {
        try
        {
            var payload = new TechnoArtSupportTicketFrontEnd.Services.APIDataAccParms { ProcID = "MARK_ALL_NOTIFICATIONS_READ" };
            await BackendApi.FetchDataAsync(payload);

            foreach (var n in notifications)
            {
                if (n.TryGetProperty("id", out var idEl))
                {
                    var nid = idEl.ValueKind == JsonValueKind.Number ? idEl.GetInt32().ToString() : idEl.GetString();
                    if (!string.IsNullOrEmpty(nid))
                    {
                        try
                        {
                            var indReq = new TechnoArtSupportTicketFrontEnd.Services.APIDataAccParms { ProcID = "READ_NOTIFICATION", parm01 = nid };
                            await BackendApi.FetchDataAsync(indReq);
                        }
                        catch { }
                    }
                }
            }

            unreadCount = 0;
            await LoadNotifications();
            await FetchUnreadCount();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in MarkAllNotificationsAsRead: {ex.Message}");
            unreadCount = 0;
            StateHasChanged();
        }
    }

    private async Task Logout()
    {
        var customAuth = (TechnoArtSupportTicketFrontEnd.Auth.CustomAuthStateProvider)AuthStateProvider;
        await customAuth.MarkUserAsLoggedOut();
        BackendApi.ClearToken();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        notifTimer?.Dispose();
    }
}
